# ============================================================
# Monica Salon — Client API configuration
# Copy this file to `.env`, lalu sesuaikan dengan mesin kamu.
# ============================================================

# Base URL API (tanpa trailing slash).
# Production:
API_BASE_URL=https://monica-salon-be.onrender.com

# Android emulator/physical device juga memakai URL production.
API_BASE_URL_ANDROID=https://monica-salon-be.onrender.com

# Prefix endpoint API.
API_PREFIX=/api/v1

# Timeout request HTTP (detik). Render free tier bisa cold start.
API_TIMEOUT_SECONDS=60

# Environment API: Development | Production
API_ENVIRONMENT=Production

# Contoh lokal:
# API_BASE_URL=http://localhost:5277
# API_BASE_URL_ANDROID=http://10.0.2.2:5277
# API_ENVIRONMENT=Development
