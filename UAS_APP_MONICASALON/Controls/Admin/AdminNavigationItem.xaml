<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="UAS_APP_MONICASALON.Controls.Admin.AdminNavigationItem"
    x:Name="NavRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid
        BackgroundColor="Transparent"
        Padding="4,2"
        SemanticProperties.Description="{Binding ScreenReaderText, Source={x:Reference NavRoot}}"
        SemanticProperties.Hint="Ketuk dua kali untuk membuka halaman ini">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Grid.GestureRecognizers>

        <VerticalStackLayout
            Spacing="2"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            InputTransparent="True"
            AutomationProperties.IsInAccessibleTree="False">
            <Label
                Text="{Binding IconGlyph, Source={x:Reference NavRoot}}"
                FontFamily="MaterialOutlined"
                FontSize="21"
                FontAutoScalingEnabled="False"
                TextColor="{StaticResource TextSecondary}"
                HorizontalTextAlignment="Center">
                <Label.Triggers>
                    <DataTrigger
                        TargetType="Label"
                        Binding="{Binding IsActive, Source={x:Reference NavRoot}}"
                        Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Label
                Text="{Binding Title, Source={x:Reference NavRoot}}"
                FontFamily="OpenSansRegular"
                FontSize="10"
                TextColor="{StaticResource TextSecondary}"
                HorizontalTextAlignment="Center"
                LineBreakMode="TailTruncation"
                MaxLines="1">
                <Label.Triggers>
                    <DataTrigger
                        TargetType="Label"
                        Binding="{Binding IsActive, Source={x:Reference NavRoot}}"
                        Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                        <Setter Property="FontFamily" Value="OpenSansSemibold" />
                        <Setter Property="FontAttributes" Value="Bold" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </VerticalStackLayout>
    </Grid>

</ContentView>
