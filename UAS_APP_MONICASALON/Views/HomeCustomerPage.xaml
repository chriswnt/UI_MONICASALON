<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.HomeCustomerPage"
    x:Name="HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:controls="clr-namespace:UAS_APP_MONICASALON.Controls"
    xmlns:m="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="#FAF7F5"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- Scrollable dashboard -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="20,16,20,20"
                Spacing="18"
                MaximumWidthRequest="720"
                HorizontalOptions="Center">

                <!-- Greeting + profile -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label
                            Text="{Binding GreetingText}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#8B2626" />
                        <Label
                            Text="Selamat datang kembali."
                            FontSize="12"
                            TextColor="#757575" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="#FFFFFF"
                        Stroke="#EFE6E4"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 22"
                        Padding="0"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Buka profil">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                        </Border.GestureRecognizers>
                        <Border
                            WidthRequest="34"
                            HeightRequest="34"
                            BackgroundColor="#FDECEC"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 17"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            InputTransparent="True">
                            <Label
                                Text="{Binding Initials}"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#8B2626"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>
                    </Border>
                </Grid>

                <!-- Search + filter -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <material:TextField
                        Title="Cari layanan, paket, atau gaya..."
                        Text="{Binding SearchText, Mode=TwoWay}"
                        AccentColor="#D9534F"
                        BorderColor="#EFE6E4"
                        CornerRadius="12"
                        BackgroundColor="#FFFFFF"
                        TextColor="#1E1E1E"
                        TitleColor="#757575"
                        FontSize="13"
                        TitleFontSize="12"
                        HeightRequest="50"
                        AllowClear="True">
                        <material:TextField.Icon>
                            <FontImageSource
                                FontFamily="MaterialOutlined"
                                Glyph="{x:Static m:MaterialRegular.Search}"
                                Color="#757575"
                                Size="21" />
                        </material:TextField.Icon>
                    </material:TextField>

                    <uranium:ButtonView
                        Grid.Column="1"
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="#D9534F"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="0"
                        VerticalOptions="End"
                        SemanticProperties.Description="Filter layanan"
                        TappedCommand="{Binding FilterCommand}">
                        <Image
                            WidthRequest="23"
                            HeightRequest="23"
                            InputTransparent="True"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Tune}"
                                    Color="#FFFFFF"
                                    Size="23" />
                            </Image.Source>
                        </Image>
                    </uranium:ButtonView>
                </Grid>

                <!-- Hero banners -->
                <VerticalStackLayout Spacing="4">
                    <CarouselView
                        ItemsSource="{Binding Banners}"
                        HeightRequest="160"
                        IndicatorView="{x:Reference bannerIndicator}"
                        Loop="False"
                        PeekAreaInsets="0"
                        IsBounceEnabled="False">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    HeightRequest="160"
                                    BackgroundColor="#FDECEC"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                    <Grid IsClippedToBounds="True">
                                        <Image
                                            HeightRequest="160"
                                            Source="{Binding ImageSource}"
                                            Aspect="AspectFill"
                                            IsVisible="{Binding HasImage}" />

                                        <VerticalStackLayout
                                            IsVisible="{Binding ShowFallback}"
                                            Padding="20"
                                            Spacing="6"
                                            VerticalOptions="Center">
                                            <Label
                                                Text="{Binding Badge}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#D9534F" />
                                            <Label
                                                Text="{Binding Title}"
                                                FontSize="21"
                                                FontAttributes="Bold"
                                                TextColor="#8B2626" />
                                            <Label
                                                Text="{Binding Subtitle}"
                                                FontSize="12"
                                                TextColor="#757575" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView
                        x:Name="bannerIndicator"
                        IndicatorColor="#E0CFCB"
                        SelectedIndicatorColor="#D9534F"
                        IndicatorSize="8"
                        HorizontalOptions="Center"
                        Margin="0,6,0,0" />
                </VerticalStackLayout>

                <!-- Categories -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Layanan"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#1E1E1E"
                            VerticalTextAlignment="Center" />
                        <Label
                            Grid.Column="1"
                            Text="Lihat Semua"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#D9534F"
                            VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeeAllServicesCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <CollectionView
                        ItemsSource="{Binding Categories}"
                        HeightRequest="96"
                        SelectionMode="None"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <uranium:ButtonView
                                    WidthRequest="60"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    Padding="0"
                                    TappedCommand="{Binding BindingContext.SelectCategoryCommand, Source={x:Reference HomePage}}"
                                    CommandParameter="{Binding .}">
                                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" InputTransparent="True">
                                        <Border
                                            WidthRequest="58"
                                            HeightRequest="58"
                                            BackgroundColor="#FDECEC"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 29">
                                            <Image
                                                WidthRequest="25"
                                                HeightRequest="25"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="MaterialOutlined"
                                                        Glyph="{Binding IconGlyph}"
                                                        Color="#D9534F"
                                                        Size="25" />
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="11"
                                            TextColor="#1E1E1E"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="WordWrap"
                                            MaxLines="2"
                                            HeightRequest="30" />
                                    </VerticalStackLayout>
                                </uranium:ButtonView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Style book highlights -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label
                                Text="Buku Gaya"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#1E1E1E" />
                            <Label
                                Text="Referensi dari admin, siap ditunjukkan ke stylist."
                                FontSize="11"
                                TextColor="#757575" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="1"
                            Text="Lihat Semua"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#D9534F"
                            VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenStyleBookCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding StyleHighlights}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        WidthRequest="106"
                                        Padding="7"
                                        BackgroundColor="#FFFFFF"
                                        Stroke="#EFE6E4"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.OpenHairstyleCommand, Source={x:Reference HomePage}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <VerticalStackLayout Spacing="5">
                                            <Border
                                                HeightRequest="96"
                                                BackgroundColor="#FDECEC"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10">
                                                <Image
                                                    Source="{Binding ImageSource}"
                                                    Aspect="AspectFill"
                                                    HeightRequest="96" />
                                            </Border>
                                            <Label
                                                Text="{Binding Name}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="#8B2626"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding MetaText}"
                                                FontSize="9"
                                                TextColor="#A79A96"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Favorite / search results -->
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{Binding SectionTitle}"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#1E1E1E" />

                    <FlexLayout
                        Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="SpaceBetween"
                        AlignItems="Start"
                        BindableLayout.ItemsSource="{Binding FavoriteServices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <uranium:ButtonView
                                    FlexLayout.Basis="48.5%"
                                    Margin="0,0,0,10"
                                    BackgroundColor="#FFFFFF"
                                    Stroke="#EFE6E4"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="10"
                                    SemanticProperties.Description="{Binding Name}"
                                    TappedCommand="{Binding BindingContext.SelectServiceCommand, Source={x:Reference HomePage}}"
                                    CommandParameter="{Binding .}">
                                    <VerticalStackLayout Spacing="8" InputTransparent="True">

                                        <Border
                                            HeightRequest="112"
                                            BackgroundColor="#FDECEC"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12">
                                            <Grid>
                                                <Border
                                                    WidthRequest="90"
                                                    HeightRequest="90"
                                                    BackgroundColor="#F8DCDC"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 45"
                                                    Opacity="0.75"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                                <Image
                                                    WidthRequest="42"
                                                    HeightRequest="42"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="MaterialOutlined"
                                                            Glyph="{Binding IconGlyph}"
                                                            Color="#D9534F"
                                                            Size="42" />
                                                    </Image.Source>
                                                </Image>

                                                <Border
                                                    WidthRequest="28"
                                                    HeightRequest="28"
                                                    BackgroundColor="#FFFFFF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 14"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    Margin="0,8,8,0">
                                                    <Image
                                                        WidthRequest="15"
                                                        HeightRequest="15"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                        <Image.Source>
                                                            <FontImageSource
                                                                FontFamily="MaterialOutlined"
                                                                Glyph="{x:Static m:MaterialRegular.Favorite}"
                                                                Color="#D9534F"
                                                                Size="15" />
                                                        </Image.Source>
                                                    </Image>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="#1E1E1E"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1" />

                                        <HorizontalStackLayout Spacing="4">
                                            <Label
                                                Text="{Binding FormattedPrice}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="#D9534F" />
                                            <Label
                                                Text="|"
                                                FontSize="12"
                                                TextColor="#D7C9C5" />
                                            <Label
                                                Text="{Binding Duration}"
                                                FontSize="12"
                                                TextColor="#757575"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>
                                </uranium:ButtonView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <VerticalStackLayout
                        IsVisible="{Binding IsSearchEmpty}"
                        Padding="0,18,0,22"
                        Spacing="8"
                        HorizontalOptions="Center">
                        <Border
                            WidthRequest="56"
                            HeightRequest="56"
                            BackgroundColor="#FDECEC"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 28"
                            HorizontalOptions="Center">
                            <Image
                                WidthRequest="26"
                                HeightRequest="26"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static m:MaterialRegular.Search}"
                                        Color="#D9534F"
                                        Size="26" />
                                </Image.Source>
                            </Image>
                        </Border>
                        <Label
                            Text="Belum ada yang cocok."
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#8B2626"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Coba kata kunci lain atau lihat semua layanan di katalog."
                            FontSize="11"
                            TextColor="#757575"
                            HorizontalTextAlignment="Center"
                            MaximumWidthRequest="260" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Shared bottom navigation -->
        <controls:BottomNavBar Grid.Row="1" ActiveTab="Home" />
    </Grid>

    <!-- Service quick preview bottom sheet -->
    <uranium:UraniumContentPage.Attachments>
        <material:BottomSheetView
            IsPresented="{Binding IsServiceDetailOpen, Mode=TwoWay}">
            <!-- The default generated header is a drag handle that stays visible
                 over the bottom navigation even while the sheet is closed. -->
            <material:BottomSheetView.Header>
                <BoxView HeightRequest="0" Color="Transparent" />
            </material:BottomSheetView.Header>
            <material:BottomSheetView.Triggers>
                <DataTrigger
                    TargetType="material:BottomSheetView"
                    Binding="{Binding IsServiceDetailOpen}"
                    Value="False">
                    <Setter Property="InputTransparent" Value="True" />
                </DataTrigger>
            </material:BottomSheetView.Triggers>
            <VerticalStackLayout Padding="20,8,20,28" Spacing="16">

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border
                        WidthRequest="52"
                        HeightRequest="52"
                        BackgroundColor="#FDECEC"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 26">
                        <Image
                            WidthRequest="26"
                            HeightRequest="26"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{Binding SelectedService.IconGlyph}"
                                    Color="#D9534F"
                                    Size="26" />
                            </Image.Source>
                        </Image>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label
                            Text="{Binding SelectedService.Name}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#1E1E1E" />
                        <Label
                            Text="{Binding SelectedService.FormattedPrice}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#D9534F" />
                    </VerticalStackLayout>

                    <uranium:ButtonView
                        Grid.Column="2"
                        WidthRequest="36"
                        HeightRequest="36"
                        BackgroundColor="#FAF7F5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="0"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Tutup detail layanan"
                        TappedCommand="{Binding CloseServiceDetailCommand}">
                        <Image
                            WidthRequest="19"
                            HeightRequest="19"
                            InputTransparent="True"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Close}"
                                    Color="#1E1E1E"
                                    Size="19" />
                            </Image.Source>
                        </Image>
                    </uranium:ButtonView>
                </Grid>

                <HorizontalStackLayout Spacing="8">
                    <Border
                        BackgroundColor="#FAF7F5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,5">
                        <HorizontalStackLayout Spacing="4">
                            <Image WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static m:MaterialRegular.Calendar_month}"
                                        Color="#757575"
                                        Size="14" />
                                </Image.Source>
                            </Image>
                            <Label
                                Text="{Binding SelectedService.Duration}"
                                FontSize="12"
                                TextColor="#757575"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>

                <Label
                    Text="{Binding SelectedService.Description}"
                    FontSize="13"
                    TextColor="#757575"
                    LineBreakMode="WordWrap" />

                <Button
                    Text="Booking Sekarang"
                    Command="{Binding BookServiceCommand}"
                    BackgroundColor="#D9534F"
                    TextColor="#FFFFFF"
                    CornerRadius="24"
                    HeightRequest="52"
                    FontAttributes="Bold"
                    FontSize="15"
                    Margin="0,4,0,0" />

            </VerticalStackLayout>
        </material:BottomSheetView>
    </uranium:UraniumContentPage.Attachments>

</uranium:UraniumContentPage>
