<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.Admin.AdminReschedulePage"
    x:Name="RescheduleRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:admin="clr-namespace:UAS_APP_MONICASALON.Controls.Admin"
    xmlns:icons="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="{StaticResource Background}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <admin:AdminLayout
        PageTitle="Jadwal Ulang"
        ActiveRoute="AdminBookingsPage">

        <admin:AdminLayout.PageContent>
            <ScrollView>
                <VerticalStackLayout Padding="20,6,20,20" Spacing="12">

                    <!-- Error state -->
                    <Border
                        Style="{StaticResource AdminErrorBanner}"
                        IsVisible="{Binding HasError}"
                        SemanticProperties.Description="{Binding ErrorMessage}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image
                                WidthRequest="16"
                                HeightRequest="16"
                                VerticalOptions="Start"
                                Style="{StaticResource AdminDecorativeIcon}">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.Warning}"
                                        Color="{StaticResource Error}"
                                        Size="16" />
                                </Image.Source>
                            </Image>
                            <Label
                                Grid.Column="1"
                                Text="{Binding ErrorMessage}"
                                Style="{StaticResource AdminBannerText}"
                                AutomationProperties.IsInAccessibleTree="False" />
                        </Grid>
                    </Border>

                    <!-- Not found state -->
                    <Border
                        Style="{StaticResource AdminCard}"
                        IsVisible="{Binding IsNotFound}"
                        SemanticProperties.Description="{Binding NotFoundTitle}">
                        <VerticalStackLayout Spacing="8" Padding="0,10">
                            <Image Style="{StaticResource AdminEmptyStateIcon}">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.EventBusy}"
                                        Color="{StaticResource Error}"
                                        Size="36" />
                                </Image.Source>
                            </Image>
                            <Label
                                Text="{Binding NotFoundTitle}"
                                Style="{StaticResource AdminCardTitle}"
                                FontSize="15"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="{Binding NotFoundCaption}"
                                Style="{StaticResource AdminCaption}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Booking summary -->
                    <Border
                        Style="{StaticResource AdminSoftCard}"
                        IsVisible="{Binding HasBooking}">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="{Binding Booking.CustomerName}"
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryDark}" />
                            <Label
                                Text="{Binding CurrentScheduleText}"
                                FontSize="12"
                                TextColor="{StaticResource PrimaryDark}"
                                LineBreakMode="WordWrap" />
                            <Label
                                Text="{Binding Booking.ServiceStaffPriceText}"
                                FontSize="12"
                                TextColor="{StaticResource PrimaryDark}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- New schedule -->
                    <Border
                        Style="{StaticResource AdminCard}"
                        IsVisible="{Binding HasBooking}">
                        <VerticalStackLayout Spacing="12">
                            <Label
                                Text="Jadwal Baru"
                                Style="{StaticResource AdminSectionTitle}"
                                FontSize="14" />

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Tanggal" Style="{StaticResource AdminFilterLabel}" />
                                <Border Style="{StaticResource AdminInputShell}">
                                    <DatePicker
                                        Date="{Binding SelectedDate, Mode=TwoWay}"
                                        MinimumDate="{Binding MinimumDate}"
                                        MaximumDate="{Binding MaximumDate}"
                                        Style="{StaticResource AdminDatePicker}"
                                        SemanticProperties.Description="Tanggal jadwal baru"
                                        SemanticProperties.Hint="Ketuk dua kali untuk membuka pemilih tanggal" />
                                </Border>
                                <Label
                                    Text="{Binding DateText}"
                                    Style="{StaticResource AdminCaption}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Jam" Style="{StaticResource AdminFilterLabel}" />
                                <Border Style="{StaticResource AdminInputShell}">
                                    <uranium:Dropdown
                                        ItemsSource="{Binding TimeSlots}"
                                        SelectedItem="{Binding SelectedTime, Mode=TwoWay}"
                                        Placeholder="Pilih jam"
                                        Style="{StaticResource AdminDropdown}"
                                        SemanticProperties.Description="Jam jadwal baru"
                                        SemanticProperties.Hint="Buka daftar untuk memilih jam" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Slot availability -->
                    <Border
                        Style="{StaticResource AdminSuccessBanner}"
                        IsVisible="{Binding IsSlotAvailable}"
                        SemanticProperties.Description="{Binding SlotStatusText}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image
                                WidthRequest="16"
                                HeightRequest="16"
                                VerticalOptions="Start"
                                Style="{StaticResource AdminDecorativeIcon}">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.EventAvailable}"
                                        Color="{StaticResource Success}"
                                        Size="16" />
                                </Image.Source>
                            </Image>
                            <Label
                                Grid.Column="1"
                                Text="{Binding SlotStatusText}"
                                Style="{StaticResource AdminBannerText}"
                                AutomationProperties.IsInAccessibleTree="False" />
                        </Grid>
                    </Border>

                    <Border
                        Style="{StaticResource AdminBannerBorder}"
                        IsVisible="{Binding IsSlotUnavailable}"
                        SemanticProperties.Description="{Binding SlotStatusText}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image
                                WidthRequest="16"
                                HeightRequest="16"
                                VerticalOptions="Start"
                                Style="{StaticResource AdminDecorativeIcon}">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.Info}"
                                        Color="{StaticResource Info}"
                                        Size="16" />
                                </Image.Source>
                            </Image>
                            <Label
                                Grid.Column="1"
                                Text="{Binding SlotStatusText}"
                                Style="{StaticResource AdminBannerText}"
                                AutomationProperties.IsInAccessibleTree="False" />
                        </Grid>
                    </Border>

                    <Button
                        Text="Simpan Jadwal"
                        Style="{StaticResource AdminPrimaryButton}"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding HasBooking}"
                        SemanticProperties.Description="Simpan jadwal baru booking ini"
                        HorizontalOptions="Fill" />

                    <Button
                        Text="Batal"
                        Style="{StaticResource AdminSecondaryButton}"
                        Command="{Binding BackCommand}"
                        SemanticProperties.Description="Batalkan dan kembali ke detail booking"
                        HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </ScrollView>
        </admin:AdminLayout.PageContent>
    </admin:AdminLayout>

</uranium:UraniumContentPage>
