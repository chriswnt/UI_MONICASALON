<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.Admin.AdminCreateBookingPage"
    x:Name="CreateBookingRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:admin="clr-namespace:UAS_APP_MONICASALON.Controls.Admin"
    xmlns:icons="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="{StaticResource Background}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <admin:AdminLayout
        PageTitle="Booking Baru"
        ActiveRoute="AdminBookingsPage">

        <admin:AdminLayout.PageContent>
            <ScrollView>
                <VerticalStackLayout Padding="20,6,20,20" Spacing="12">

                    <!-- Error state -->
                    <Border
                        Style="{StaticResource AdminErrorBanner}"
                        IsVisible="{Binding HasError}"
                        SemanticProperties.Description="{Binding ErrorMessage}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image
                                WidthRequest="16"
                                HeightRequest="16"
                                VerticalOptions="Start"
                                Style="{StaticResource AdminDecorativeIcon}">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.Warning}"
                                        Color="{StaticResource Error}"
                                        Size="16" />
                                </Image.Source>
                            </Image>
                            <Label
                                Grid.Column="1"
                                Text="{Binding ErrorMessage}"
                                Style="{StaticResource AdminBannerText}"
                                AutomationProperties.IsInAccessibleTree="False" />
                        </Grid>
                    </Border>

                    <!-- Success state -->
                    <Border
                        Style="{StaticResource AdminSuccessBanner}"
                        IsVisible="{Binding IsSaved}"
                        SemanticProperties.Description="{Binding SuccessMessage}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image
                                WidthRequest="16"
                                HeightRequest="16"
                                VerticalOptions="Start"
                                Style="{StaticResource AdminDecorativeIcon}">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.Success}"
                                        Color="{StaticResource Success}"
                                        Size="16" />
                                </Image.Source>
                            </Image>
                            <Label
                                Grid.Column="1"
                                Text="{Binding SuccessMessage}"
                                Style="{StaticResource AdminBannerText}"
                                AutomationProperties.IsInAccessibleTree="False" />
                        </Grid>
                    </Border>

                    <!-- Customer -->
                    <Border Style="{StaticResource AdminCard}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Image
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    VerticalOptions="Center"
                                    Style="{StaticResource AdminDecorativeIcon}">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="MaterialOutlined"
                                            Glyph="{x:Static icons:AdminIcons.NewCustomer}"
                                            Color="{StaticResource Primary}"
                                            Size="16" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Grid.Column="1"
                                    Text="Pelanggan"
                                    Style="{StaticResource AdminSectionTitle}"
                                    FontSize="14" />
                            </Grid>

                            <Border Style="{StaticResource AdminInputShell}">
                                <material:TextField
                                    Title="Nama pelanggan"
                                    Text="{Binding CustomerName}"
                                    Style="{StaticResource AdminTextField}"
                                    SemanticProperties.Description="Nama pelanggan"
                                    SemanticProperties.Hint="Wajib diisi" />
                            </Border>

                            <Border Style="{StaticResource AdminInputShell}">
                                <material:TextField
                                    Title="No. HP"
                                    Text="{Binding CustomerPhone}"
                                    Keyboard="Telephone"
                                    Style="{StaticResource AdminTextField}"
                                    SemanticProperties.Description="Nomor HP pelanggan"
                                    SemanticProperties.Hint="Wajib diisi" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Booking details -->
                    <Border Style="{StaticResource AdminCard}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Image
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    VerticalOptions="Center"
                                    Style="{StaticResource AdminDecorativeIcon}">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="MaterialOutlined"
                                            Glyph="{x:Static icons:AdminIcons.Bookings}"
                                            Color="{StaticResource Primary}"
                                            Size="16" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Grid.Column="1"
                                    Text="Detail Booking"
                                    Style="{StaticResource AdminSectionTitle}"
                                    FontSize="14" />
                            </Grid>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Layanan" Style="{StaticResource AdminFilterLabel}" />
                                <Border Style="{StaticResource AdminInputShell}">
                                    <uranium:Dropdown
                                        ItemsSource="{Binding ServiceNames}"
                                        SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                                        Placeholder="Pilih layanan"
                                        Style="{StaticResource AdminDropdown}"
                                        SemanticProperties.Description="Layanan yang dibooking" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Stylist" Style="{StaticResource AdminFilterLabel}" />
                                <Border Style="{StaticResource AdminInputShell}">
                                    <uranium:Dropdown
                                        ItemsSource="{Binding StaffNames}"
                                        SelectedItem="{Binding SelectedStaff, Mode=TwoWay}"
                                        Placeholder="Pilih stylist"
                                        Style="{StaticResource AdminDropdown}"
                                        SemanticProperties.Description="Stylist yang menangani" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Tanggal" Style="{StaticResource AdminFilterLabel}" />
                                <Border Style="{StaticResource AdminInputShell}">
                                    <DatePicker
                                        Date="{Binding SelectedDate, Mode=TwoWay}"
                                        MinimumDate="{Binding MinimumDate}"
                                        MaximumDate="{Binding MaximumDate}"
                                        Style="{StaticResource AdminDatePicker}"
                                        SemanticProperties.Description="Tanggal booking"
                                        SemanticProperties.Hint="Ketuk dua kali untuk membuka pemilih tanggal" />
                                </Border>
                                <Label
                                    Text="{Binding DateText}"
                                    Style="{StaticResource AdminCaption}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Jam" Style="{StaticResource AdminFilterLabel}" />
                                <Border Style="{StaticResource AdminInputShell}">
                                    <uranium:Dropdown
                                        ItemsSource="{Binding TimeSlots}"
                                        SelectedItem="{Binding SelectedTime, Mode=TwoWay}"
                                        Placeholder="Pilih jam"
                                        Style="{StaticResource AdminDropdown}"
                                        SemanticProperties.Description="Jam booking" />
                                </Border>
                            </VerticalStackLayout>

                            <BoxView Style="{StaticResource AdminReceiptRule}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Durasi" Style="{StaticResource AdminSummaryLabel}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding DurationText}"
                                    Style="{StaticResource AdminSummaryValue}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Harga" Style="{StaticResource AdminSummaryLabel}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding PriceText}"
                                    Style="{StaticResource AdminAmountPrimary}"
                                    FontSize="13" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Slot availability: success + info states -->
                    <Border
                        Style="{StaticResource AdminSuccessBanner}"
                        IsVisible="{Binding IsSlotAvailable}"
                        SemanticProperties.Description="{Binding SlotStatusText}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image
                                WidthRequest="16"
                                HeightRequest="16"
                                VerticalOptions="Start"
                                Style="{StaticResource AdminDecorativeIcon}">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.EventAvailable}"
                                        Color="{StaticResource Success}"
                                        Size="16" />
                                </Image.Source>
                            </Image>
                            <Label
                                Grid.Column="1"
                                Text="{Binding SlotStatusText}"
                                Style="{StaticResource AdminBannerText}"
                                AutomationProperties.IsInAccessibleTree="False" />
                        </Grid>
                    </Border>

                    <Border
                        Style="{StaticResource AdminBannerBorder}"
                        IsVisible="{Binding IsSlotUnavailable}"
                        SemanticProperties.Description="{Binding SlotStatusText}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image
                                WidthRequest="16"
                                HeightRequest="16"
                                VerticalOptions="Start"
                                Style="{StaticResource AdminDecorativeIcon}">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.Info}"
                                        Color="{StaticResource Info}"
                                        Size="16" />
                                </Image.Source>
                            </Image>
                            <Label
                                Grid.Column="1"
                                Text="{Binding SlotStatusText}"
                                Style="{StaticResource AdminBannerText}"
                                AutomationProperties.IsInAccessibleTree="False" />
                        </Grid>
                    </Border>

                    <!-- Notes -->
                    <Border Style="{StaticResource AdminCard}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Image
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    VerticalOptions="Center"
                                    Style="{StaticResource AdminDecorativeIcon}">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="MaterialOutlined"
                                            Glyph="{x:Static icons:AdminIcons.Notes}"
                                            Color="{StaticResource Primary}"
                                            Size="16" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Grid.Column="1"
                                    Text="Catatan"
                                    Style="{StaticResource AdminSectionTitle}"
                                    FontSize="14" />
                            </Grid>

                            <Border Style="{StaticResource AdminInputShell}">
                                <material:TextField
                                    Title="Catatan (opsional)"
                                    Text="{Binding Notes}"
                                    Style="{StaticResource AdminTextField}"
                                    SemanticProperties.Description="Catatan booking"
                                    SemanticProperties.Hint="{Binding NotesHintText}" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Button
                        Text="Simpan Booking"
                        Style="{StaticResource AdminPrimaryButton}"
                        Command="{Binding SaveCommand}"
                        SemanticProperties.Description="Simpan booking baru"
                        SemanticProperties.Hint="Ketuk dua kali untuk menyimpan booking"
                        HorizontalOptions="Fill" />

                    <Button
                        Text="Batal"
                        Style="{StaticResource AdminSecondaryButton}"
                        Command="{Binding CancelCommand}"
                        SemanticProperties.Description="Batalkan dan kembali ke daftar booking"
                        HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </ScrollView>
        </admin:AdminLayout.PageContent>
    </admin:AdminLayout>

</uranium:UraniumContentPage>
