<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.Admin.TransactionHistoryPage"
    x:Name="HistoryRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:admin="clr-namespace:UAS_APP_MONICASALON.Controls.Admin"
    xmlns:icons="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="{StaticResource Background}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <admin:AdminLayout
        PageTitle="Riwayat Transaksi"
        ActiveRoute="CashierPage">

        <admin:AdminLayout.PageContent>
            <Grid
                Padding="20,6,20,20"
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                RowSpacing="10">

                <!-- Today's statistics -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <admin:StatCard
                        Title="Transaksi Hari Ini"
                        Value="{Binding TodayCountText}"
                        Caption="{Binding TodayCaptionText}"
                        IconGlyph="{x:Static icons:AdminIcons.ReceiptShort}" />

                    <admin:StatCard
                        Grid.Column="1"
                        Title="Pendapatan Hari Ini"
                        Value="{Binding TodayRevenueText}"
                        Caption="{Binding AverageBasketCaption}"
                        IconGlyph="{x:Static icons:AdminIcons.Revenue}" />
                </Grid>

                <!-- Back to the previous page (normally Kasir) + search -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button
                        Style="{StaticResource AdminIconGlyphButton}"
                        Command="{Binding GoBackCommand}"
                        SemanticProperties.Description="Kembali ke halaman sebelumnya"
                        SemanticProperties.Hint="Ketuk dua kali untuk kembali ke halaman Kasir"
                        VerticalOptions="Center">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="MaterialOutlined"
                                Glyph="{x:Static icons:AdminIcons.Back}"
                                Color="{StaticResource TextPrimary}"
                                Size="18" />
                        </Button.ImageSource>
                    </Button>

                    <Border Grid.Column="1" Style="{StaticResource AdminInputShell}">
                        <material:TextField
                            Title="Cari nomor transaksi, pelanggan, atau staf..."
                            Text="{Binding SearchText}"
                            Style="{StaticResource AdminTextField}"
                            SemanticProperties.Description="Cari transaksi"
                            SemanticProperties.Hint="Ketik nomor transaksi, nama pelanggan, atau nama staf" />
                    </Border>
                </Grid>

                <!-- Filters -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Periode" Style="{StaticResource AdminFilterLabel}" />
                        <Border Style="{StaticResource AdminInputShell}">
                            <uranium:Dropdown
                                ItemsSource="{Binding RangeFilters}"
                                SelectedItem="{Binding SelectedRangeFilter, Mode=TwoWay}"
                                Placeholder="Semua tanggal"
                                Style="{StaticResource AdminDropdown}"
                                SemanticProperties.Description="Filter periode transaksi"
                                SemanticProperties.Hint="Buka daftar untuk memilih periode" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="Metode" Style="{StaticResource AdminFilterLabel}" />
                        <Border Style="{StaticResource AdminInputShell}">
                            <uranium:Dropdown
                                ItemsSource="{Binding MethodFilters}"
                                SelectedItem="{Binding SelectedMethodFilter, Mode=TwoWay}"
                                Placeholder="Semua metode"
                                Style="{StaticResource AdminDropdown}"
                                SemanticProperties.Description="Filter metode pembayaran"
                                SemanticProperties.Hint="Buka daftar untuk memilih metode" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Result summary -->
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label
                        Text="{Binding ResultsText}"
                        Style="{StaticResource AdminCaption}"
                        VerticalTextAlignment="Center" />
                    <Label
                        Grid.Column="1"
                        Text="{Binding SyncText}"
                        Style="{StaticResource AdminCaption}"
                        VerticalTextAlignment="Center" />
                    <Button
                        Grid.Column="2"
                        Text="Reset Filter"
                        Style="{StaticResource AdminLinkButton}"
                        Command="{Binding ClearFiltersCommand}"
                        IsVisible="{Binding HasActiveFilters}"
                        SemanticProperties.Description="Reset semua filter riwayat transaksi" />
                </Grid>

                <!-- Transactions -->
                <RefreshView
                    Grid.Row="4"
                    IsRefreshing="{Binding IsLoading}"
                    Command="{Binding RefreshCommand}"
                    RefreshColor="{StaticResource Primary}"
                    SemanticProperties.Description="Daftar riwayat transaksi">
                    <CollectionView
                        ItemsSource="{Binding FilteredTransactions}"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureAllItems"
                        VerticalScrollBarVisibility="Default">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Style="{StaticResource AdminCard}"
                                    Padding="14"
                                    Margin="0,0,0,10"
                                    SemanticProperties.Description="{Binding ScreenReaderText}"
                                    SemanticProperties.Hint="{Binding ScreenReaderHint}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.OpenTransactionCommand, Source={x:Reference HistoryRoot}}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" InputTransparent="True">
                                        <Border
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="{StaticResource Secondary}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 17"
                                            VerticalOptions="Center"
                                            AutomationProperties.IsInAccessibleTree="False"
                                            AutomationProperties.ExcludedWithChildren="True">
                                            <Label
                                                Text="{Binding CustomerInitials}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Primary}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalOptions="Center"
                                            AutomationProperties.IsInAccessibleTree="False"
                                            AutomationProperties.ExcludedWithChildren="True">
                                            <Label
                                                Text="{Binding CustomerName}"
                                                Style="{StaticResource AdminCellTitle}"
                                                FontSize="13" />
                                            <Label
                                                Text="{Binding CustomerMeta}"
                                                Style="{StaticResource AdminCellMeta}" />

                                            <HorizontalStackLayout Spacing="4" Margin="0,2,0,0">
                                                <Image
                                                    WidthRequest="12"
                                                    HeightRequest="12"
                                                    VerticalOptions="Center"
                                                    Style="{StaticResource AdminDecorativeIcon}">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="MaterialOutlined"
                                                            Glyph="{Binding MethodIconGlyph}"
                                                            Color="{StaticResource TextSecondary}"
                                                            Size="12" />
                                                    </Image.Source>
                                                </Image>
                                                <Label
                                                    Text="{Binding MethodText}"
                                                    Style="{StaticResource AdminCellMeta}"
                                                    VerticalTextAlignment="Center" />
                                                <Label
                                                    Text="·"
                                                    Style="{StaticResource AdminCellMeta}"
                                                    VerticalTextAlignment="Center" />
                                                <Label
                                                    Text="{Binding ItemCountText}"
                                                    Style="{StaticResource AdminCellMeta}"
                                                    VerticalTextAlignment="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="2"
                                            Spacing="3"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            AutomationProperties.IsInAccessibleTree="False"
                                            AutomationProperties.ExcludedWithChildren="True">
                                            <admin:PaymentBadge
                                                Text="{Binding StatusText}"
                                                Status="{Binding Status}"
                                                HorizontalOptions="End" />
                                            <Label
                                                Text="{Binding TotalText}"
                                                Style="{StaticResource AdminAmountPrimary}"
                                                FontSize="12"
                                                HorizontalTextAlignment="End" />
                                            <Label
                                                Text="{Binding TimeText}"
                                                Style="{StaticResource AdminCellMeta}"
                                                FontSize="10"
                                                HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout
                                Padding="24"
                                Spacing="6"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                SemanticProperties.Description="Riwayat transaksi kosong">
                                <Image Style="{StaticResource AdminEmptyStateIcon}">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="MaterialOutlined"
                                            Glyph="{x:Static icons:AdminIcons.EmptyHistory}"
                                            Color="{StaticResource TextSecondary}"
                                            Size="36" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Text="Belum ada transaksi"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Text="Coba ubah kata kunci, periode, atau metode pembayaran."
                                    Style="{StaticResource AdminCaption}"
                                    HorizontalTextAlignment="Center" />
                                <Button
                                    Text="Transaksi Baru"
                                    Style="{StaticResource AdminCompactButton}"
                                    Command="{Binding StartNewTransactionCommand}"
                                    SemanticProperties.Description="Mulai transaksi baru di halaman kasir"
                                    HorizontalOptions="Center"
                                    Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </RefreshView>
            </Grid>
        </admin:AdminLayout.PageContent>
    </admin:AdminLayout>

</uranium:UraniumContentPage>
