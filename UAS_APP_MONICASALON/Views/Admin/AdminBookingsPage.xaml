<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.Admin.AdminBookingsPage"
    x:Name="BookingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:admin="clr-namespace:UAS_APP_MONICASALON.Controls.Admin"
    xmlns:icons="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="{StaticResource Background}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <admin:AdminLayout
        PageTitle="Booking"
        ActiveRoute="AdminBookingsPage">

        <admin:AdminLayout.PageContent>
            <Grid
                Padding="20,6,20,20"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="12">

                <!-- Search and filters -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource AdminInputShell}">
                            <material:TextField
                                Title="Cari nama, layanan, atau ID..."
                                Text="{Binding SearchText}"
                                Style="{StaticResource AdminTextField}"
                                SemanticProperties.Description="Cari booking"
                                SemanticProperties.Hint="Ketik nama pelanggan, nomor HP, layanan, staf, atau ID booking">
                                <material:TextField.Icon>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.Search}"
                                        Color="{StaticResource TextSecondary}"
                                        Size="18" />
                                </material:TextField.Icon>
                            </material:TextField>
                        </Border>

                        <Button
                            Grid.Column="1"
                            Style="{StaticResource AdminIconGlyphPrimaryButton}"
                            Command="{Binding NewBookingCommand}"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Booking Baru"
                            SemanticProperties.Hint="Ketuk dua kali untuk membuat booking baru">
                            <Button.ImageSource>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static icons:AdminIcons.Add}"
                                    Color="{StaticResource OnPrimary}"
                                    Size="18" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="Tanggal"
                                Style="{StaticResource AdminFilterLabel}" />
                            <Border Style="{StaticResource AdminInputShell}">
                                <DatePicker
                                    Date="{Binding DateFilterInput, Mode=TwoWay}"
                                    MinimumDate="{Binding MinimumDate}"
                                    MaximumDate="{Binding MaximumDate}"
                                    Style="{StaticResource AdminDatePicker}"
                                    SemanticProperties.Description="Filter tanggal booking"
                                    SemanticProperties.Hint="Ketuk dua kali untuk memilih tanggal" />
                            </Border>
                            <Button
                                Text="Semua Tanggal"
                                Style="{StaticResource AdminLinkButton}"
                                Command="{Binding ClearDateFilterCommand}"
                                IsVisible="{Binding HasDateFilter}"
                                SemanticProperties.Description="Hapus filter tanggal"
                                HorizontalOptions="Start" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label
                                Text="Status"
                                Style="{StaticResource AdminFilterLabel}" />
                            <Border Style="{StaticResource AdminInputShell}">
                                <uranium:Dropdown
                                    ItemsSource="{Binding StatusFilters}"
                                    SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                    Placeholder="Pilih status"
                                    Style="{StaticResource AdminDropdown}"
                                    SemanticProperties.Description="Filter status booking"
                                    SemanticProperties.Hint="Buka daftar untuk memilih status" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- Result summary -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <Label
                        Text="{Binding ResultsText}"
                        Style="{StaticResource AdminCaption}"
                        VerticalTextAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Text="Reset Filter"
                        Style="{StaticResource AdminLinkButton}"
                        Command="{Binding ClearFiltersCommand}"
                        IsVisible="{Binding HasActiveFilters}" />
                </Grid>

                <!-- Booking cards -->
                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding FilteredBookings}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureAllItems"
                    VerticalScrollBarVisibility="Default">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Style="{StaticResource AdminCard}"
                                Padding="14"
                                Margin="0,0,0,10"
                                SemanticProperties.Description="{Binding ScreenReaderText}"
                                SemanticProperties.Hint="{Binding ScreenReaderHint}">
                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="{StaticResource Secondary}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 17"
                                            VerticalOptions="Center"
                                            AutomationProperties.IsInAccessibleTree="False">
                                            <Label
                                                Text="{Binding CustomerInitials}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Primary}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="1"
                                            VerticalOptions="Center"
                                            AutomationProperties.IsInAccessibleTree="False">
                                            <Label
                                                Text="{Binding CustomerName}"
                                                Style="{StaticResource AdminCellTitle}"
                                                FontSize="13" />
                                            <Label
                                                Text="{Binding CustomerMeta}"
                                                Style="{StaticResource AdminCellMeta}" />
                                        </VerticalStackLayout>

                                        <admin:StatusBadge
                                            Grid.Column="2"
                                            Text="{Binding StatusText}"
                                            Status="{Binding Status}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            AutomationProperties.IsInAccessibleTree="False" />
                                    </Grid>

                                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Outline}" />

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        RowDefinitions="Auto,Auto"
                                        ColumnSpacing="12"
                                        RowSpacing="8"
                                        AutomationProperties.IsInAccessibleTree="False">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="Layanan" Style="{StaticResource AdminCaption}" />
                                            <Label
                                                Text="{Binding ServiceName}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource TextPrimary}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="Staf" Style="{StaticResource AdminCaption}" />
                                            <Label
                                                Text="{Binding StaffName}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource TextPrimary}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1" Spacing="1">
                                            <Label Text="Jadwal" Style="{StaticResource AdminCaption}" />
                                            <Label
                                                Text="{Binding ScheduleText}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource TextPrimary}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="1">
                                            <Label Text="Harga" Style="{StaticResource AdminCaption}" />
                                            <Label
                                                Text="{Binding PriceText}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Primary}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Button
                                        Text="Lihat Detail"
                                        Style="{StaticResource AdminSoftButton}"
                                        HeightRequest="30"
                                        Padding="14,0"
                                        Command="{Binding BindingContext.ShowDetailCommand, Source={x:Reference BookingsPage}}"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="Lihat Detail"
                                        SemanticProperties.Hint="{Binding ScreenReaderText}"
                                        HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            Padding="24"
                            Spacing="6"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Image
                                WidthRequest="36"
                                HeightRequest="36"
                                HorizontalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.EmptyBookings}"
                                        Color="{StaticResource TextSecondary}"
                                        Size="36" />
                                </Image.Source>
                            </Image>
                            <Label
                                Text="Tidak ada booking"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Coba ubah kata kunci atau filter tanggal dan status."
                                Style="{StaticResource AdminCaption}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </admin:AdminLayout.PageContent>
    </admin:AdminLayout>

    <uranium:UraniumContentPage.Attachments>
        <!-- Booking detail sheet -->
        <material:BottomSheetView IsPresented="{Binding IsDetailOpen, Mode=TwoWay}">
            <material:BottomSheetView.Header>
                <BoxView HeightRequest="0" Color="Transparent" />
            </material:BottomSheetView.Header>
            <material:BottomSheetView.Triggers>
                <DataTrigger
                    TargetType="material:BottomSheetView"
                    Binding="{Binding IsDetailOpen}"
                    Value="False">
                    <Setter Property="InputTransparent" Value="True" />
                    <!-- Accessibility: keep the closed sheet out of the screen-reader order. -->
                    <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
                </DataTrigger>
            </material:BottomSheetView.Triggers>

            <ScrollView MaximumHeightRequest="560">
                <VerticalStackLayout Padding="16,4,16,16" Spacing="10">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border
                            WidthRequest="44"
                            HeightRequest="44"
                            BackgroundColor="{StaticResource Secondary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            VerticalOptions="Center">
                            <Label
                                Text="{Binding SelectedBooking.CustomerInitials}"
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Primary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label
                                Text="{Binding SelectedBooking.CustomerName}"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" />
                            <Label
                                Text="{Binding SelectedBooking.CustomerPhone}"
                                FontSize="11.5"
                                TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <uranium:ButtonView
                            Grid.Column="2"
                            Style="{StaticResource AdminIconButton}"
                            WidthRequest="34"
                            HeightRequest="34"
                            BackgroundColor="{StaticResource Background}"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Tutup detail booking"
                            TappedCommand="{Binding CloseDetailCommand}">
                            <Image
                                WidthRequest="17"
                                HeightRequest="17"
                                InputTransparent="True"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.Close}"
                                        Color="{StaticResource TextPrimary}"
                                        Size="17" />
                                </Image.Source>
                            </Image>
                        </uranium:ButtonView>
                    </Grid>

                    <Label
                        Text="{Binding SelectedBooking.CustomerMeta}"
                        Style="{StaticResource AdminCaption}" />

                    <Border
                        BackgroundColor="{StaticResource Background}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                                <Label Text="Layanan" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding SelectedBooking.ServiceName}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />
                            </Grid>

                            <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                                <Label Text="Staf" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding SelectedBooking.StaffName}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />
                            </Grid>

                            <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                                <Label Text="Jadwal" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label
                                        Text="{Binding SelectedBooking.ScheduleText}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}" />
                                    <HorizontalStackLayout
                                        Spacing="4"
                                        IsVisible="{Binding SelectedBooking.IsSlotLocked}">
                                        <Image
                                            WidthRequest="11"
                                            HeightRequest="11"
                                            VerticalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="MaterialOutlined"
                                                    Glyph="{x:Static icons:AdminIcons.SlotLocked}"
                                                    Color="{StaticResource Success}"
                                                    Size="11" />
                                            </Image.Source>
                                        </Image>
                                        <Label
                                            Text="Slot waktu terkunci"
                                            Style="{StaticResource AdminCaption}"
                                            TextColor="{StaticResource Success}"
                                            VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                                <Label Text="Durasi" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding SelectedBooking.DurationText}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />
                            </Grid>

                            <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                                <Label Text="Status" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                                <admin:StatusBadge
                                    Grid.Column="1"
                                    Text="{Binding SelectedBooking.StatusText}"
                                    Status="{Binding SelectedBooking.Status}" />
                            </Grid>

                            <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                                <Label Text="Pembayaran" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                                <admin:PaymentBadge
                                    Grid.Column="1"
                                    Text="{Binding SelectedBooking.PaymentStatusText}"
                                    Status="{Binding SelectedBooking.PaymentStatus}" />
                            </Grid>

                            <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                                <Label Text="Harga" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding SelectedBooking.PriceText}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Primary}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowPendingActions}">
                        <Button
                            Text="Konfirmasi Booking"
                            Style="{StaticResource AdminPrimaryButton}"
                            Command="{Binding ConfirmBookingCommand}"
                            HorizontalOptions="Fill" />
                        <Button
                            Text="Tolak Booking"
                            Style="{StaticResource AdminDangerButton}"
                            Command="{Binding RejectBookingCommand}"
                            HorizontalOptions="Fill" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowConfirmedActions}">
                        <Button
                            Text="Selesaikan Booking"
                            Style="{StaticResource AdminPrimaryButton}"
                            Command="{Binding CompleteBookingCommand}"
                            HorizontalOptions="Fill" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button
                                Text="Jadwal Ulang"
                                Style="{StaticResource AdminSecondaryButton}"
                                Command="{Binding OpenRescheduleCommand}"
                                HorizontalOptions="Fill" />
                            <Button
                                Grid.Column="1"
                                Text="Batalkan"
                                Style="{StaticResource AdminDangerButton}"
                                Command="{Binding CancelBookingCommand}"
                                HorizontalOptions="Fill" />
                        </Grid>
                    </VerticalStackLayout>

                    <Button
                        Text="Hubungi Pelanggan"
                        Style="{StaticResource AdminSecondaryButton}"
                        Command="{Binding ContactCustomerCommand}"
                        SemanticProperties.Description="Hubungi pelanggan booking ini"
                        HorizontalOptions="Fill" />

                    <!-- Full-page detail keeps the sheet as a quick peek. -->
                    <Button
                        Text="Buka Halaman Detail"
                        Style="{StaticResource AdminLinkButton}"
                        Command="{Binding OpenFullDetailCommand}"
                        SemanticProperties.Description="Buka halaman detail booking lengkap"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>
            </ScrollView>
        </material:BottomSheetView>

        <!-- Reschedule sheet -->
        <material:BottomSheetView
            IsPresented="{Binding IsRescheduleOpen, Mode=TwoWay}"
            CloseOnTapOutside="False">
            <material:BottomSheetView.Header>
                <BoxView HeightRequest="0" Color="Transparent" />
            </material:BottomSheetView.Header>
            <material:BottomSheetView.Triggers>
                <DataTrigger
                    TargetType="material:BottomSheetView"
                    Binding="{Binding IsRescheduleOpen}"
                    Value="False">
                    <Setter Property="InputTransparent" Value="True" />
                    <!-- Accessibility: keep the closed sheet out of the screen-reader order. -->
                    <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
                </DataTrigger>
            </material:BottomSheetView.Triggers>

            <VerticalStackLayout Padding="16,4,16,16" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label
                            Text="Jadwal Ulang"
                            Style="{StaticResource AdminSectionTitle}"
                            FontSize="14" />
                        <Label
                            Text="{Binding SelectedBooking.CustomerName}"
                            Style="{StaticResource AdminCaption}" />
                    </VerticalStackLayout>

                    <uranium:ButtonView
                        Grid.Column="1"
                        Style="{StaticResource AdminIconButton}"
                        WidthRequest="34"
                        HeightRequest="34"
                        BackgroundColor="{StaticResource Background}"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Tutup jadwal ulang"
                        TappedCommand="{Binding CloseRescheduleCommand}">
                        <Image
                            WidthRequest="17"
                            HeightRequest="17"
                            InputTransparent="True"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static icons:AdminIcons.Close}"
                                    Color="{StaticResource TextPrimary}"
                                    Size="17" />
                            </Image.Source>
                        </Image>
                    </uranium:ButtonView>
                </Grid>

                <VerticalStackLayout Spacing="3">
                    <Label
                        Text="Tanggal Baru"
                        Style="{StaticResource AdminFilterLabel}" />
                    <Border Style="{StaticResource AdminInputShell}">
                        <DatePicker
                            Date="{Binding RescheduleDateInput, Mode=TwoWay}"
                            MinimumDate="{Binding RescheduleMinimumDate}"
                            MaximumDate="{Binding RescheduleMaximumDate}"
                            Style="{StaticResource AdminDatePicker}"
                            SemanticProperties.Description="Tanggal jadwal baru"
                            SemanticProperties.Hint="Ketuk dua kali untuk membuka pemilih tanggal" />
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label
                        Text="Jam"
                        Style="{StaticResource AdminFilterLabel}"
                        VerticalOptions="Center" />
                    <Border Grid.Column="1" Style="{StaticResource AdminInputShell}">
                        <uranium:Dropdown
                            ItemsSource="{Binding TimeSlots}"
                            SelectedItem="{Binding RescheduleTime, Mode=TwoWay}"
                            Placeholder="Pilih jam"
                            Style="{StaticResource AdminDropdown}" />
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                        Text="Batal"
                        Style="{StaticResource AdminSecondaryButton}"
                        Command="{Binding CloseRescheduleCommand}"
                        HorizontalOptions="Fill" />
                    <Button
                        Grid.Column="1"
                        Text="Simpan Jadwal"
                        Style="{StaticResource AdminPrimaryButton}"
                        Command="{Binding SaveRescheduleCommand}"
                        HorizontalOptions="Fill" />
                </Grid>
            </VerticalStackLayout>
        </material:BottomSheetView>
    </uranium:UraniumContentPage.Attachments>

</uranium:UraniumContentPage>
