<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.SchedulePage"
    x:Name="ScheduleView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:m="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="#FAF7F5"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16,20,20" Spacing="16">

                <uranium:ButtonView
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0"
                    TappedCommand="{Binding BackCommand}"
                    SemanticProperties.Description="Kembali">
                    <HorizontalStackLayout Spacing="4" InputTransparent="True">
                        <Image WidthRequest="17" HeightRequest="17" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Arrow_back}"
                                    Color="#8B2626"
                                    Size="17" />
                            </Image.Source>
                        </Image>
                        <Label
                            Text="Kembali"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#8B2626"
                            VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </uranium:ButtonView>

                <VerticalStackLayout Spacing="4">
                    <Label Text="LANGKAH 1 DARI 3" Style="{StaticResource PageKickerStyle}" />
                    <Label Text="Pilih Jadwal &amp; Gaya" Style="{StaticResource PageHeadingStyle}" />
                    <Label
                        Text="Pilih layanan, tanggal, dan jam yang tersedia. Slot langsung dikunci untukmu."
                        FontSize="12"
                        TextColor="#757575"
                        LineHeight="1.35" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="6">
                    <Border
                        BackgroundColor="#D9534F"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,5">
                        <Label Text="1 Waktu" FontSize="10" FontAttributes="Bold" TextColor="#FFFFFF" />
                    </Border>
                    <Border
                        BackgroundColor="#FFFFFF"
                        Stroke="#EFE6E4"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,5">
                        <Label Text="2 Konfirmasi" FontSize="10" TextColor="#A79A96" />
                    </Border>
                    <Border
                        BackgroundColor="#FFFFFF"
                        Stroke="#EFE6E4"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,5">
                        <Label Text="3 Selesai" FontSize="10" TextColor="#A79A96" />
                    </Border>
                </HorizontalStackLayout>

                <!-- ============ SERVICES ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="1. Pilih Layanan" Style="{StaticResource SectionTitleStyle}" />
                                <Label
                                    Text="{Binding ServiceSummaryText}"
                                    Style="{StaticResource SectionCaptionStyle}"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#FDECEC"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,6"
                                VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleServiceEditorCommand}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="Ubah"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#D9534F" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout
                            Spacing="0"
                            IsVisible="{Binding IsServiceEditorVisible}"
                            BindableLayout.ItemsSource="{Binding Services}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,8">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.ToggleServiceCommand, Source={x:Reference ScheduleView}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Border
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            BackgroundColor="#FFFFFF"
                                            Stroke="#D8C6C1"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#D9534F" />
                                                    <Setter Property="Stroke" Value="#D9534F" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Image
                                                WidthRequest="13"
                                                HeightRequest="13"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                IsVisible="False">
                                                <Image.Triggers>
                                                    <DataTrigger TargetType="Image" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Image.Triggers>
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="MaterialOutlined"
                                                        Glyph="{x:Static m:MaterialRegular.Check}"
                                                        Color="#FFFFFF"
                                                        Size="13" />
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding Service.Name}"
                                                FontSize="13"
                                                TextColor="#8B2626" />
                                            <Label
                                                Text="{Binding Service.MetaText}"
                                                FontSize="10"
                                                TextColor="#A79A96" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding Service.FormattedPrice}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="#8B2626"
                                            VerticalTextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label
                            Text="Pilih minimal satu layanan. Ketuk baris untuk menambah atau menghapus."
                            FontSize="10"
                            TextColor="#A79A96"
                            IsVisible="{Binding IsServiceEditorVisible}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ DATE STRIP ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="2. Pilih Tanggal" Style="{StaticResource SectionTitleStyle}" />
                                <Label
                                    Text="{Binding SelectedDateText}"
                                    Style="{StaticResource SectionCaptionStyle}"
                                    FontAttributes="Bold"
                                    TextColor="#8B2626" />
                            </VerticalStackLayout>

                            <ActivityIndicator
                                Grid.Column="1"
                                IsVisible="{Binding IsLoadingDates}"
                                IsRunning="{Binding IsLoadingDates}"
                                Color="#D9534F"
                                WidthRequest="20"
                                HeightRequest="20"
                                VerticalOptions="Center" />
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Dates}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            WidthRequest="62"
                                            HeightRequest="86"
                                            Padding="4"
                                            BackgroundColor="{Binding BackgroundColor}"
                                            Stroke="{Binding BorderColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            Opacity="{Binding Opacity}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SelectDateCommand, Source={x:Reference ScheduleView}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <VerticalStackLayout
                                                Spacing="1"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center">
                                                <Label
                                                    Text="{Binding DayShort}"
                                                    FontSize="10"
                                                    TextColor="{Binding SubTextColor}"
                                                    HorizontalTextAlignment="Center" />
                                                <Label
                                                    Text="{Binding DayNumber}"
                                                    FontSize="19"
                                                    FontAttributes="Bold"
                                                    TextColor="{Binding TextColor}"
                                                    HorizontalTextAlignment="Center" />
                                                <Label
                                                    Text="{Binding MonthShort}"
                                                    FontSize="9"
                                                    TextColor="{Binding SubTextColor}"
                                                    HorizontalTextAlignment="Center" />
                                                <Label
                                                    Text="{Binding SlotText}"
                                                    FontSize="8"
                                                    FontAttributes="Bold"
                                                    TextColor="{Binding SubTextColor}"
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0,2,0,0" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ TIME SLOTS ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="3. Pilih Jam" Style="{StaticResource SectionTitleStyle}" />
                                <Label
                                    Text="Slot tersedia dari jadwal admin salon."
                                    Style="{StaticResource SectionCaptionStyle}" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#FDECEC"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="9,4"
                                VerticalOptions="Center">
                                <Label
                                    Text="{Binding SelectedTimeText}"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#D9534F" />
                            </Border>
                        </Grid>

                        <ActivityIndicator
                            IsVisible="{Binding IsLoadingSlots}"
                            IsRunning="{Binding IsLoadingSlots}"
                            Color="#D9534F"
                            WidthRequest="24"
                            HeightRequest="24"
                            HorizontalOptions="Center"
                            Margin="0,6" />

                        <FlexLayout
                            Wrap="Wrap"
                            Direction="Row"
                            AlignItems="Start"
                            JustifyContent="Start"
                            BindableLayout.ItemsSource="{Binding TimeSlots}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        FlexLayout.Basis="30%"
                                        HeightRequest="58"
                                        Margin="0,0,8,8"
                                        Padding="4"
                                        BackgroundColor="{Binding BackgroundColor}"
                                        Stroke="{Binding BorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Opacity="{Binding Opacity}"
                                        IsVisible="{Binding IsAvailable}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.SelectSlotCommand, Source={x:Reference ScheduleView}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout
                                            Spacing="1"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center">
                                            <Label
                                                Text="{Binding Label}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="{Binding TextColor}"
                                                HorizontalTextAlignment="Center" />
                                            <Label
                                                Text="{Binding StatusText}"
                                                FontSize="8"
                                                TextColor="{Binding SubTextColor}"
                                                HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Border
                            IsVisible="{Binding HasSlotError}"
                            BackgroundColor="#F9DEDC"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,8">
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    Text="{Binding SlotErrorMessage}"
                                    FontSize="10"
                                    TextColor="#B3261E"
                                    LineBreakMode="WordWrap" />
                                <Button
                                    Text="Coba Lagi"
                                    Command="{Binding RetrySlotsCommand}"
                                    BackgroundColor="#D9534F"
                                    TextColor="#FFFFFF"
                                    CornerRadius="10"
                                    HeightRequest="32"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Start"
                                    Padding="12,0" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout
                            IsVisible="{Binding ShowSlotEmpty}"
                            Spacing="8"
                            Padding="0,4">
                            <Label
                                Text="{Binding SlotEmptyText}"
                                FontSize="11"
                                TextColor="#A79A96"
                                HorizontalTextAlignment="Center"
                                LineHeight="1.35" />
                            <Button
                                Text="Muat Ulang Slot"
                                Command="{Binding RetrySlotsCommand}"
                                Style="{StaticResource SecondaryActionStyle}"
                                HeightRequest="38"
                                CornerRadius="12"
                                FontSize="11"
                                HorizontalOptions="Center"
                                Padding="16,0" />
                        </VerticalStackLayout>

                        <Label
                            Text="Semua slot terisi ditampilkan dengan warna lebih pudar."
                            FontSize="10"
                            TextColor="#A79A96" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ HAIRSTYLE ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="4. Referensi Gaya" Style="{StaticResource SectionTitleStyle}" />
                                    <Label
                                        Text="Opsional"
                                        FontSize="9"
                                        TextColor="#A79A96"
                                        VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="Katalog dikelola admin. Pilih satu agar stylist tahu hasil yang kamu mau."
                                    Style="{StaticResource SectionCaptionStyle}" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#FDECEC"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,6"
                                VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BrowseHairstylesCommand}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="Style Book"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#D9534F" />
                            </Border>
                        </Grid>

                        <Border
                            BackgroundColor="#FAF7F5"
                            Stroke="#F2E8E5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border
                                    WidthRequest="46"
                                    HeightRequest="46"
                                    BackgroundColor="#FDECEC"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Center">
                                    <Image
                                        Source="{Binding SelectedHairstyleImage}"
                                        Aspect="AspectFill"
                                        WidthRequest="46"
                                        HeightRequest="46" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding HairstyleSummary}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#8B2626"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation" />
                                    <Label
                                        Text="Tanpa referensi pun tetap bisa konsultasi di salon."
                                        FontSize="10"
                                        TextColor="#A79A96" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Hairstyles}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            WidthRequest="86"
                                            Padding="6"
                                            BackgroundColor="{Binding CardBackgroundColor}"
                                            Stroke="{Binding CardBorderColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SelectHairstyleCommand, Source={x:Reference ScheduleView}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <VerticalStackLayout Spacing="5">
                                                <Border
                                                    HeightRequest="62"
                                                    BackgroundColor="#FDECEC"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10">
                                                    <Image
                                                        Source="{Binding ImageSource}"
                                                        Aspect="AspectFill"
                                                        HeightRequest="62" />
                                                </Border>
                                                <Label
                                                    Text="{Binding Name}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#8B2626"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation"
                                                    HorizontalTextAlignment="Center" />
                                                <Label
                                                    Text="{Binding Category}"
                                                    FontSize="8"
                                                    TextColor="#A79A96"
                                                    HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ ADD-ONS ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="5. Tambahan" Style="{StaticResource SectionTitleStyle}" />
                                <Label
                                    Text="Opsional"
                                    FontSize="9"
                                    TextColor="#A79A96"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Label
                                Text="Produk dan perawatan tambahan dengan harga tetap dari admin."
                                Style="{StaticResource SectionCaptionStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding AddOns}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,9">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.ToggleAddOnCommand, Source={x:Reference ScheduleView}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Border
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            BackgroundColor="#FFFFFF"
                                            Stroke="#D8C6C1"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#D9534F" />
                                                    <Setter Property="Stroke" Value="#D9534F" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Image
                                                WidthRequest="13"
                                                HeightRequest="13"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                IsVisible="False">
                                                <Image.Triggers>
                                                    <DataTrigger TargetType="Image" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Image.Triggers>
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="MaterialOutlined"
                                                        Glyph="{x:Static m:MaterialRegular.Check}"
                                                        Color="#FFFFFF"
                                                        Size="13" />
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding AddOn.Name}"
                                                FontSize="13"
                                                TextColor="#8B2626" />
                                            <Label
                                                Text="{Binding AddOn.Description}"
                                                FontSize="10"
                                                TextColor="#A79A96"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding AddOn.FormattedPrice}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#8B2626"
                                                HorizontalTextAlignment="End" />
                                            <Label
                                                Text="{Binding AddOn.BadgeText}"
                                                FontSize="8"
                                                TextColor="#A79A96"
                                                HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ NOTES / POLICY ============ -->
                <Border BackgroundColor="#FFFFFF" Stroke="#EFE6E4" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sebelum Konfirmasi" Style="{StaticResource SectionTitleStyle}" />
                        <Label
                            Text="• Slot yang kamu pilih langsung dikunci, tanpa menunggu konfirmasi."
                            FontSize="11"
                            TextColor="#757575"
                            LineHeight="1.35" />
                        <Label
                            Text="• Datang 10 menit sebelum jadwal agar layanan tidak terpotong."
                            FontSize="11"
                            TextColor="#757575"
                            LineHeight="1.35" />
                        <Label
                            Text="• Pembayaran dilakukan di salon setelah layanan selesai."
                            FontSize="11"
                            TextColor="#757575"
                            LineHeight="1.35" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ STICKY SUMMARY ============ -->
        <Grid
            Grid.Row="1"
            RowDefinitions="1,Auto"
            BackgroundColor="#FFFFFF">
            <BoxView HeightRequest="1" BackgroundColor="#EFE6E4" />
            <VerticalStackLayout Grid.Row="1" Padding="20,12,20,16" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label
                            Text="Estimasi total"
                            FontSize="11"
                            TextColor="#757575" />
                        <Label
                            Text="{Binding SelectedCountText}"
                            FontSize="10"
                            TextColor="#A79A96" />
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="1"
                        Text="{Binding TotalText}"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#8B2626"
                        VerticalTextAlignment="Center" />
                </Grid>

                <Label
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    TextColor="#B3261E"
                    FontSize="11"
                    HorizontalTextAlignment="Center" />

                <Button
                    Text="Lanjut ke Konfirmasi"
                    Command="{Binding ContinueCommand}"
                    Style="{StaticResource PrimaryActionStyle}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</uranium:UraniumContentPage>
