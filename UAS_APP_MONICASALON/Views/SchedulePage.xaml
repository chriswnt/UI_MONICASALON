<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.SchedulePage"
    x:Name="ScheduleView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:controls="clr-namespace:UAS_APP_MONICASALON.Controls"
    xmlns:m="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="#FAF7F5"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16,20,20" Spacing="16">

                <uranium:ButtonView
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0"
                    TappedCommand="{Binding BackCommand}"
                    SemanticProperties.Description="Kembali">
                    <HorizontalStackLayout Spacing="4" InputTransparent="True">
                        <Image WidthRequest="17" HeightRequest="17" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Arrow_back}"
                                    Color="#8B2626"
                                    Size="17" />
                            </Image.Source>
                        </Image>
                        <Label
                            Text="Kembali"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#8B2626"
                            VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </uranium:ButtonView>

                <VerticalStackLayout Spacing="4">
                    <Label Text="LANGKAH 1 DARI 3" Style="{StaticResource PageKickerStyle}" />
                    <Label Text="Pilih Jadwal &amp; Gaya" Style="{StaticResource PageHeadingStyle}" />
                    <Label
                        Text="Pilih layanan, tanggal, dan jam. Permintaan booking akan dikirim ke admin untuk disetujui."
                        FontSize="12"
                        TextColor="#757575"
                        LineHeight="1.35" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="6">
                    <Border
                        BackgroundColor="#D9534F"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,5">
                        <Label Text="1 Waktu" FontSize="10" FontAttributes="Bold" TextColor="#FFFFFF" />
                    </Border>
                    <Border
                        BackgroundColor="#FFFFFF"
                        Stroke="#EFE6E4"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,5">
                        <Label Text="2 Konfirmasi" FontSize="10" TextColor="#A79A96" />
                    </Border>
                    <Border
                        BackgroundColor="#FFFFFF"
                        Stroke="#EFE6E4"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,5">
                        <Label Text="3 Selesai" FontSize="10" TextColor="#A79A96" />
                    </Border>
                </HorizontalStackLayout>

                <!-- ============ SERVICES ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="1. Pilih Layanan" Style="{StaticResource SectionTitleStyle}" />
                                <Label
                                    Text="{Binding ServiceSummaryText}"
                                    Style="{StaticResource SectionCaptionStyle}"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#FDECEC"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,6"
                                VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleServiceEditorCommand}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="Ubah"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#D9534F" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout
                            Spacing="0"
                            IsVisible="{Binding IsServiceEditorVisible}"
                            BindableLayout.ItemsSource="{Binding Services}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,8">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.ToggleServiceCommand, Source={x:Reference ScheduleView}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Border
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            BackgroundColor="#FFFFFF"
                                            Stroke="#D8C6C1"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#D9534F" />
                                                    <Setter Property="Stroke" Value="#D9534F" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Image
                                                WidthRequest="13"
                                                HeightRequest="13"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                IsVisible="False">
                                                <Image.Triggers>
                                                    <DataTrigger TargetType="Image" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Image.Triggers>
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="MaterialOutlined"
                                                        Glyph="{x:Static m:MaterialRegular.Check}"
                                                        Color="#FFFFFF"
                                                        Size="13" />
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding Service.Name}"
                                                FontSize="13"
                                                TextColor="#8B2626" />
                                            <Label
                                                Text="{Binding Service.MetaText}"
                                                FontSize="10"
                                                TextColor="#A79A96" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding Service.FormattedPrice}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="#8B2626"
                                            VerticalTextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label
                            Text="Pilih minimal satu layanan. Ketuk baris untuk menambah atau menghapus."
                            FontSize="10"
                            TextColor="#A79A96"
                            IsVisible="{Binding IsServiceEditorVisible}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ SCHEDULE PICKERS ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="2. Pilih Tanggal &amp; Jam" Style="{StaticResource SectionTitleStyle}" />
                            <Label
                                Text="Ketuk kolom di bawah untuk membuka pemilih tanggal dan jam Material."
                                Style="{StaticResource SectionCaptionStyle}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <!-- Date field -> native Material calendar dialog -->
                            <Border
                                BackgroundColor="#FAF7F5"
                                Stroke="#F2E8E5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,8">
                                <VerticalStackLayout Spacing="2">
                                    <HorizontalStackLayout Spacing="5">
                                        <Image WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="MaterialOutlined"
                                                    Glyph="{x:Static m:MaterialRegular.Calendar_month}"
                                                    Color="#D9534F"
                                                    Size="14" />
                                            </Image.Source>
                                        </Image>
                                        <Label
                                            Text="Tanggal"
                                            FontSize="10"
                                            TextColor="#A79A96"
                                            VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                    <DatePicker
                                        Date="{Binding SelectedDateValue, Mode=TwoWay}"
                                        MinimumDate="{Binding MinimumDate}"
                                        MaximumDate="{Binding MaximumDate}"
                                        Format="d MMM yyyy"
                                        FontFamily="PlusJakartaSansSemiBold"
                                        FontSize="13"
                                        TextColor="#8B2626"
                                        BackgroundColor="Transparent"
                                        HeightRequest="34"
                                        HorizontalOptions="Fill"
                                        SemanticProperties.Description="Tanggal kunjungan"
                                        SemanticProperties.Hint="Ketuk untuk membuka pemilih tanggal" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Time field -> custom Material clock dialog -->
                            <Border
                                Grid.Column="1"
                                BackgroundColor="#FAF7F5"
                                Stroke="#F2E8E5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,8"
                                SemanticProperties.Description="Jam kunjungan"
                                SemanticProperties.Hint="Ketuk untuk membuka pemilih jam">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenTimePickerCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <HorizontalStackLayout Spacing="5">
                                        <Image WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="MaterialOutlined"
                                                    Glyph="{x:Static m:MaterialRegular.Schedule}"
                                                    Color="#D9534F"
                                                    Size="14" />
                                            </Image.Source>
                                        </Image>
                                        <Label
                                            Text="Jam"
                                            FontSize="10"
                                            TextColor="#A79A96"
                                            VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                    <Grid ColumnDefinitions="*,Auto" HeightRequest="34">
                                        <Label
                                            Text="{Binding SelectedTimeText}"
                                            FontFamily="PlusJakartaSansSemiBold"
                                            FontSize="13"
                                            TextColor="#8B2626"
                                            VerticalTextAlignment="Center" />
                                        <Image
                                            Grid.Column="1"
                                            WidthRequest="16"
                                            HeightRequest="16"
                                            VerticalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="MaterialOutlined"
                                                    Glyph="{x:Static m:MaterialRegular.Expand_more}"
                                                    Color="#B08A84"
                                                    Size="16" />
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Border
                            BackgroundColor="#FFFFFF"
                            Stroke="#EFE6E4"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Image WidthRequest="15" HeightRequest="15" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="MaterialOutlined"
                                            Glyph="{x:Static m:MaterialRegular.Event}"
                                            Color="#D9534F"
                                            Size="15" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding ScheduleSummaryText}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#8B2626"
                                    VerticalTextAlignment="Center"
                                    LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>

                        <Border
                            BackgroundColor="#FEF3C7"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Image WidthRequest="15" HeightRequest="15" VerticalOptions="Start" Margin="0,1,0,0">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="MaterialOutlined"
                                            Glyph="{x:Static m:MaterialRegular.Info}"
                                            Color="#8A5A00"
                                            Size="15" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Grid.Column="1"
                                    Text="Setelah dikirim, admin mengecek ketersediaan jadwal. Status booking tetap Menunggu Konfirmasi sampai disetujui."
                                    FontSize="10"
                                    TextColor="#8A5A00"
                                    LineHeight="1.35"
                                    LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>

                        <Label
                            Text="Jam operasional salon: 09.00–19.00. Pilih waktu di dalam rentang tersebut."
                            FontSize="10"
                            TextColor="#A79A96" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ HAIRSTYLE ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="3. Referensi Gaya" Style="{StaticResource SectionTitleStyle}" />
                                    <Label
                                        Text="Opsional"
                                        FontSize="9"
                                        TextColor="#A79A96"
                                        VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="Katalog dikelola admin. Pilih satu agar stylist tahu hasil yang kamu mau."
                                    Style="{StaticResource SectionCaptionStyle}" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#FDECEC"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,6"
                                VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BrowseHairstylesCommand}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="Style Book"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#D9534F" />
                            </Border>
                        </Grid>

                        <Border
                            BackgroundColor="#FAF7F5"
                            Stroke="#F2E8E5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border
                                    WidthRequest="46"
                                    HeightRequest="46"
                                    BackgroundColor="#FDECEC"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Center">
                                    <Image
                                        Source="{Binding SelectedHairstyleImage}"
                                        Aspect="AspectFill"
                                        WidthRequest="46"
                                        HeightRequest="46" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding HairstyleSummary}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#8B2626"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation" />
                                    <Label
                                        Text="Tanpa referensi pun tetap bisa konsultasi di salon."
                                        FontSize="10"
                                        TextColor="#A79A96" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Hairstyles}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            WidthRequest="86"
                                            Padding="6"
                                            BackgroundColor="{Binding CardBackgroundColor}"
                                            Stroke="{Binding CardBorderColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SelectHairstyleCommand, Source={x:Reference ScheduleView}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <VerticalStackLayout Spacing="5">
                                                <Border
                                                    HeightRequest="62"
                                                    BackgroundColor="#FDECEC"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10">
                                                    <Image
                                                        Source="{Binding ImageSource}"
                                                        Aspect="AspectFill"
                                                        HeightRequest="62" />
                                                </Border>
                                                <Label
                                                    Text="{Binding Name}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#8B2626"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation"
                                                    HorizontalTextAlignment="Center" />
                                                <Label
                                                    Text="{Binding Category}"
                                                    FontSize="8"
                                                    TextColor="#A79A96"
                                                    HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ ADD-ONS ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="4. Tambahan" Style="{StaticResource SectionTitleStyle}" />
                                <Label
                                    Text="Opsional"
                                    FontSize="9"
                                    TextColor="#A79A96"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Label
                                Text="Produk dan perawatan tambahan dengan harga tetap dari admin."
                                Style="{StaticResource SectionCaptionStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding AddOns}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,9">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.ToggleAddOnCommand, Source={x:Reference ScheduleView}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Border
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            BackgroundColor="#FFFFFF"
                                            Stroke="#D8C6C1"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#D9534F" />
                                                    <Setter Property="Stroke" Value="#D9534F" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Image
                                                WidthRequest="13"
                                                HeightRequest="13"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                IsVisible="False">
                                                <Image.Triggers>
                                                    <DataTrigger TargetType="Image" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Image.Triggers>
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="MaterialOutlined"
                                                        Glyph="{x:Static m:MaterialRegular.Check}"
                                                        Color="#FFFFFF"
                                                        Size="13" />
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding AddOn.Name}"
                                                FontSize="13"
                                                TextColor="#8B2626" />
                                            <Label
                                                Text="{Binding AddOn.Description}"
                                                FontSize="10"
                                                TextColor="#A79A96"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding AddOn.FormattedPrice}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#8B2626"
                                                HorizontalTextAlignment="End" />
                                            <Label
                                                Text="{Binding AddOn.BadgeText}"
                                                FontSize="8"
                                                TextColor="#A79A96"
                                                HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ NOTES / POLICY ============ -->
                <Border BackgroundColor="#FFFFFF" Stroke="#EFE6E4" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sebelum Konfirmasi" Style="{StaticResource SectionTitleStyle}" />
                        <Label
                            Text="• Booking berstatus Menunggu Konfirmasi sampai admin menyetujui jadwalmu."
                            FontSize="11"
                            TextColor="#757575"
                            LineHeight="1.35" />
                        <Label
                            Text="• Datang 10 menit sebelum jadwal agar layanan tidak terpotong."
                            FontSize="11"
                            TextColor="#757575"
                            LineHeight="1.35" />
                        <Label
                            Text="• Pembayaran dilakukan di salon setelah layanan selesai."
                            FontSize="11"
                            TextColor="#757575"
                            LineHeight="1.35" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ STICKY SUMMARY ============ -->
        <Grid
            Grid.Row="1"
            RowDefinitions="1,Auto"
            BackgroundColor="#FFFFFF">
            <BoxView HeightRequest="1" BackgroundColor="#EFE6E4" />
            <VerticalStackLayout Grid.Row="1" Padding="20,12,20,16" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label
                            Text="Estimasi total"
                            FontSize="11"
                            TextColor="#757575" />
                        <Label
                            Text="{Binding SelectedCountText}"
                            FontSize="10"
                            TextColor="#A79A96" />
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="1"
                        Text="{Binding TotalText}"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#8B2626"
                        VerticalTextAlignment="Center" />
                </Grid>

                <Label
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    TextColor="#B3261E"
                    FontSize="11"
                    HorizontalTextAlignment="Center" />

                <Button
                    Text="Lanjut ke Konfirmasi"
                    Command="{Binding ContinueCommand}"
                    Style="{StaticResource PrimaryActionStyle}" />
            </VerticalStackLayout>
        </Grid>

        <!-- ============ MATERIAL CLOCK TIME PICKER ============ -->
        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding IsTimePickerOpen}"
            BackgroundColor="#99000000"
            Padding="20"
            ZIndex="20">

            <Border
                BackgroundColor="#FFFFFF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                Padding="20,16,20,12"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="340">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="PILIH JAM"
                        FontSize="10"
                        FontAttributes="Bold"
                        CharacterSpacing="1.6"
                        TextColor="#A79A96" />

                    <!-- Hour / minute selection + AM PM -->
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border
                            WidthRequest="86"
                            HeightRequest="62"
                            BackgroundColor="#FAF7F5"
                            Stroke="#F2E8E5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectHourDialCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsHourDial}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#FDECEC" />
                                    <Setter Property="Stroke" Value="#F5C9C7" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label
                                Text="{Binding PickerHourText}"
                                FontSize="34"
                                TextColor="#8B2626"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsHourDial}" Value="True">
                                        <Setter Property="TextColor" Value="#D9534F" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                        <Label
                            Text=":"
                            FontSize="30"
                            TextColor="#8B2626"
                            VerticalOptions="Center" />

                        <Border
                            WidthRequest="86"
                            HeightRequest="62"
                            BackgroundColor="#FAF7F5"
                            Stroke="#F2E8E5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectMinuteDialCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsMinuteDial}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#FDECEC" />
                                    <Setter Property="Stroke" Value="#F5C9C7" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label
                                Text="{Binding PickerMinuteText}"
                                FontSize="34"
                                TextColor="#8B2626"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsMinuteDial}" Value="True">
                                        <Setter Property="TextColor" Value="#D9534F" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Border
                                WidthRequest="48"
                                HeightRequest="29"
                                BackgroundColor="#FFFFFF"
                                Stroke="#EFE6E4"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectAmCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsAmSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#FDECEC" />
                                        <Setter Property="Stroke" Value="#D9534F" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label
                                    Text="AM"
                                    FontSize="10"
                                    TextColor="#757575"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsAmSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#D9534F" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border
                                WidthRequest="48"
                                HeightRequest="29"
                                BackgroundColor="#FFFFFF"
                                Stroke="#EFE6E4"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectPmCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsPmSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#FDECEC" />
                                        <Setter Property="Stroke" Value="#D9534F" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label
                                    Text="PM"
                                    FontSize="10"
                                    TextColor="#757575"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPmSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#D9534F" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <controls:ClockDialView
                        WidthRequest="270"
                        HeightRequest="270"
                        HorizontalOptions="Center"
                        Mode="{Binding ClockMode}"
                        Hour="{Binding ClockHour12, Mode=TwoWay}"
                        Minute="{Binding ClockMinute, Mode=TwoWay}" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                        <Label
                            Text="Salon buka 09.00–19.00"
                            FontSize="9"
                            TextColor="#A79A96"
                            VerticalTextAlignment="Center"
                            LineBreakMode="WordWrap" />

                        <Button
                            Grid.Column="1"
                            Text="BATAL"
                            Command="{Binding CloseTimePickerCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#8B2626"
                            FontSize="11"
                            FontAttributes="Bold"
                            HeightRequest="40"
                            MinimumHeightRequest="40"
                            Padding="10,0"
                            CornerRadius="20"
                            SemanticProperties.Description="Tutup pemilih jam tanpa menyimpan" />

                        <Button
                            Grid.Column="2"
                            Text="OK"
                            Command="{Binding ConfirmTimePickerCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#D9534F"
                            FontSize="11"
                            FontAttributes="Bold"
                            HeightRequest="40"
                            MinimumHeightRequest="40"
                            Padding="10,0"
                            CornerRadius="20"
                            SemanticProperties.Description="Simpan jam yang dipilih" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</uranium:UraniumContentPage>
