<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.HairstyleDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:m="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="#FAF7F5"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <Grid HeightRequest="320" BackgroundColor="#FDECEC">
                    <Image
                        Source="{Binding Style.ImageOrPlaceholder}"
                        Aspect="AspectFit"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill" />

                    <uranium:ButtonView
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="16,16,0,0"
                        HeightRequest="38"
                        BackgroundColor="#FBF5F1"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 19"
                        Padding="13,0"
                        TappedCommand="{Binding BackCommand}"
                        SemanticProperties.Description="Kembali">
                        <HorizontalStackLayout Spacing="4" InputTransparent="True" VerticalOptions="Center">
                            <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static m:MaterialRegular.Arrow_back}"
                                        Color="#8B2626"
                                        Size="16" />
                                </Image.Source>
                            </Image>
                            <Label
                                Text="Kembali"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#8B2626"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </uranium:ButtonView>

                    <Border
                        IsVisible="{Binding Style.IsTrending}"
                        BackgroundColor="#D9534F"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,4"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,16,16,0">
                        <Label
                            Text="TRENDING"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"
                            CharacterSpacing="1" />
                    </Border>
                </Grid>

                <Border
                    BackgroundColor="#FAF7F5"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Margin="0,-24,0,0"
                    Padding="20,22,20,28">
                    <VerticalStackLayout Spacing="14">

                        <HorizontalStackLayout Spacing="8">
                            <Border
                                BackgroundColor="#FDECEC"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 9"
                                Padding="9,4">
                                <Label
                                    Text="{Binding Style.Category}"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#8B2626" />
                            </Border>
                            <Border
                                BackgroundColor="#FFFFFF"
                                Stroke="#EFE6E4"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 9"
                                Padding="9,4">
                                <Label
                                    Text="{Binding Style.LengthText}"
                                    FontSize="10"
                                    TextColor="#757575" />
                            </Border>
                        </HorizontalStackLayout>

                        <Label
                            Text="{Binding Style.Name}"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="#8B2626"
                            LineBreakMode="WordWrap" />

                        <Label
                            Text="{Binding Style.Description}"
                            FontSize="13"
                            TextColor="#757575"
                            LineHeight="1.4"
                            LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Panjang" Style="{StaticResource FieldLabelStyle}" />
                                    <Label
                                        Text="{Binding Style.LengthText}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#8B2626" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Bentuk wajah" Style="{StaticResource FieldLabelStyle}" />
                                    <Label
                                        Text="{Binding Style.FaceShape}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#8B2626"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Perawatan" Style="{StaticResource FieldLabelStyle}" />
                                    <Label
                                        Text="{Binding Style.MaintenanceText}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#8B2626" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Estimasi waktu" Style="{StaticResource FieldLabelStyle}" />
                                    <Label
                                        Text="{Binding Style.DurationText}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#8B2626"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Cocok untuk" Style="{StaticResource SectionTitleStyle}" />
                            <FlexLayout
                                Wrap="Wrap"
                                JustifyContent="Start"
                                BindableLayout.ItemsSource="{Binding Style.Tags}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            BackgroundColor="#FFFFFF"
                                            Stroke="#EFE6E4"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="11,5"
                                            Margin="0,0,8,8">
                                            <Label
                                                Text="{Binding .}"
                                                FontSize="11"
                                                TextColor="#757575" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <Border Style="{StaticResource CardStyle}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Cocok Dipadukan Dengan" Style="{StaticResource SectionTitleStyle}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SuggestedServices}" Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,6">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label
                                                        Text="{Binding Name}"
                                                        FontSize="13"
                                                        FontAttributes="Bold"
                                                        TextColor="#1E1E1E" />
                                                    <Label
                                                        Text="{Binding MetaText}"
                                                        FontSize="10"
                                                        TextColor="#A79A96" />
                                                </VerticalStackLayout>
                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding FormattedPrice}"
                                                    FontSize="12"
                                                    TextColor="#D9534F"
                                                    VerticalTextAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Button
                                    Text="Lihat Semua Layanan"
                                    Command="{Binding OpenCatalogueCommand}"
                                    Style="{StaticResource SecondaryActionStyle}"
                                    HeightRequest="42"
                                    FontSize="12" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            BackgroundColor="#FDECEC"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="13">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Image WidthRequest="20" HeightRequest="20" VerticalOptions="Start" Margin="0,1,0,0">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="MaterialOutlined"
                                            Glyph="{x:Static m:MaterialRegular.Info}"
                                            Color="#8B2626"
                                            Size="20" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Grid.Column="1"
                                    Text="Gaya ini adalah referensi. Stylist akan menyesuaikan potongan dengan tekstur rambut dan bentuk wajahmu."
                                    FontSize="11"
                                    TextColor="#8B2626"
                                    LineHeight="1.35" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" BackgroundColor="#FFFFFF" RowDefinitions="1,Auto">
            <BoxView HeightRequest="1" BackgroundColor="#EFE6E4" />
            <VerticalStackLayout Grid.Row="1" Padding="20,10,20,16" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Estimasi biaya gaya" FontSize="10" TextColor="#A79A96" />
                        <Label
                            Text="{Binding Style.FormattedPriceValue}"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#8B2626" />
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="1"
                        Text="Konsultasi gratis"
                        FontSize="11"
                        TextColor="#2E7D32"
                        VerticalTextAlignment="Center" />
                </Grid>
                <Button
                    Text="Pakai Gaya Ini &amp; Booking"
                    Command="{Binding BookWithStyleCommand}"
                    Style="{StaticResource PrimaryActionStyle}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</uranium:UraniumContentPage>
