                            HeightRequest="21"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Content_cut}"
                                    Color="#FFFFFF"
                                    Size="21" />
                            </Image.Source>
                        </Image>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label
                            Text="Monica Salon"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"
                            CharacterSpacing="0.6" />
                        <Label
                            Text="HAIR &amp; BEAUTY STUDIO"
                            FontSize="8"
                            TextColor="#D9FFFFFF"
                            CharacterSpacing="1.7" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Greeting -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Rambut sehat,&#10;percaya diri baru."
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        LineHeight="1.12" />
                    <Label
                        Text="Perawatan rambut dan kecantikan, dibuat personal untukmu."
                        FontSize="12"
                        TextColor="#E8FFFFFF"
                        LineHeight="1.35"
                        MaximumWidthRequest="300"
                        HorizontalOptions="Start" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Wave transition into the white sheet -->
            <GraphicsView
                HeightRequest="96"
                HorizontalOptions="Fill"
                VerticalOptions="End"
                InputTransparent="True">
                <GraphicsView.Drawable>
                    <drawables:LoginWaveDrawable />
                </GraphicsView.Drawable>
            </GraphicsView>
        </Grid>

        <!-- ================= SIGN IN SHEET ================= -->
        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never"
            BackgroundColor="#FFFFFF">

            <VerticalStackLayout
                x:Name="LoginContent"
                Padding="0,12,0,30"
                Spacing="0"
                HorizontalOptions="Center"
                VerticalOptions="Start">

                <Label
                    Text="Masuk"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#8B2626" />

                <Border
                    WidthRequest="44"
                    HeightRequest="4"
                    BackgroundColor="#D9534F"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 2"
                    HorizontalOptions="Start"
                    Margin="0,7,0,0" />

                <Label
                    Text="Masuk untuk melihat jadwal, booking, dan katalog gaya."
                    FontSize="12"
                    TextColor="#757575"
                    LineHeight="1.35"
                    Margin="0,11,0,0" />

