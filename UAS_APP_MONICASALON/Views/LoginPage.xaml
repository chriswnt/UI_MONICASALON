<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.LoginPage"
    x:Name="LoginView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:input="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
    xmlns:drawables="clr-namespace:UAS_APP_MONICASALON.Drawables"
    xmlns:m="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="#FFFFFF"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" RowSpacing="-1" BackgroundColor="#FFFFFF">

        <!-- ================= HERO ================= -->
        <Grid x:Name="HeroHost" Grid.Row="0" HeightRequest="316">
            <Image
                Source="login_hero.png"
                Aspect="AspectFill"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <!-- Wave transition into the white sheet -->
            <GraphicsView
                HeightRequest="96"
                HorizontalOptions="Fill"
                VerticalOptions="End"
                InputTransparent="True">
                <GraphicsView.Drawable>
                    <drawables:LoginWaveDrawable />
                </GraphicsView.Drawable>
            </GraphicsView>
        </Grid>

        <!-- ================= SIGN IN SHEET ================= -->
        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never"
            BackgroundColor="#FFFFFF">

            <VerticalStackLayout
                x:Name="LoginContent"
                Padding="0,12,0,30"
                Spacing="0"
                HorizontalOptions="Center"
                VerticalOptions="Start">

                <Label
                    Text="Masuk"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#8B2626" />

                <Border
                    WidthRequest="44"
                    HeightRequest="4"
                    BackgroundColor="#D9534F"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 2"
                    HorizontalOptions="Start"
                    Margin="0,7,0,0" />

                <Label
                    Text="Masuk sebagai customer untuk booking, atau gunakan akun admin untuk mengelola salon."
                    FontSize="12"
                    TextColor="#757575"
                    LineHeight="1.35"
                    Margin="0,11,0,0" />

                <input:FormView
                    SubmitCommand="{Binding LoginCommand}"
                    Margin="0,22,0,0">

                    <VerticalStackLayout Spacing="0">

                        <material:TextField
                            Title="Email atau No. HP"
                            Text="{Binding Identifier}"
                            AccentColor="#D9534F"
                            BorderColor="#F0DFDB"
                            BackgroundColor="#FCF8F7"
                            CornerRadius="14"
                            FontSize="14"
                            HeightRequest="56">
                            <material:TextField.Icon>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Person}"
                                    Color="#B08A84"
                                    Size="20" />
                            </material:TextField.Icon>
                        </material:TextField>

                        <material:TextField
                            Title="Password"
                            Text="{Binding Password}"
                            IsPassword="True"
                            AccentColor="#D9534F"
                            BorderColor="#F0DFDB"
                            BackgroundColor="#FCF8F7"
                            CornerRadius="14"
                            FontSize="14"
                            HeightRequest="56"
                            Margin="0,12,0,0">
                            <material:TextField.Icon>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Lock}"
                                    Color="#B08A84"
                                    Size="20" />
                            </material:TextField.Icon>
                            <material:TextField.Attachments>
                                <material:TextFieldPasswordShowHideAttachment />
                            </material:TextField.Attachments>
                        </material:TextField>

                        <!-- Remember + forgot -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                            <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                <CheckBox
                                    IsChecked="{Binding RememberMe}"
                                    Color="#D9534F"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="Ingat saya"
                                    FontSize="12"
                                    TextColor="#757575"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="Lupa password?"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#D9534F"
                                VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Error -->
                        <Border
                            IsVisible="{Binding HasError}"
                            BackgroundColor="#FDECEC"
                            Stroke="#F5C9C7"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,9"
                            Margin="0,14,0,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label
                                    Text="!"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#B3261E"
                                    VerticalOptions="Start" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding ErrorMessage}"
                                    FontSize="11"
                                    TextColor="#B3261E"
                                    LineHeight="1.35" />
                            </Grid>
                        </Border>

                        <Button
                            Text="Masuk"
                            input:FormView.IsSubmitButton="True"
                            BackgroundColor="#D9534F"
                            TextColor="#FFFFFF"
                            CornerRadius="16"
                            HeightRequest="54"
                            FontAttributes="Bold"
                            FontSize="15"
                            Margin="0,18,0,0" />
                    </VerticalStackLayout>
                </input:FormView>

                <HorizontalStackLayout
                    Spacing="4"
                    HorizontalOptions="Center"
                    Margin="0,16,0,0">
                    <Label
                        Text="Belum punya akun?"
                        FontSize="12"
                        TextColor="#757575"
                        VerticalOptions="Center" />
                    <Label
                        Text="Daftar"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#D9534F"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <Label
                    Text="Mode demo: email dan password apa pun bisa digunakan. Ketik email yang mengandung &quot;admin&quot; untuk membuka panel admin."
                    FontSize="10"
                    TextColor="#A79A96"
                    HorizontalTextAlignment="Center"
                    LineHeight="1.3"
                    Margin="0,16,0,0" />

                <Label
                    Text="Butuh bantuan? Hubungi resepsionis di +62 812-3456-7890"
                    FontSize="10"
                    TextColor="#A79A96"
                    HorizontalTextAlignment="Center"
                    Margin="0,7,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</uranium:UraniumContentPage>
