    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" RowSpacing="-1" BackgroundColor="#FFFFFF">

        <!-- ================= HERO ================= -->
        <Grid x:Name="HeroHost" Grid.Row="0" HeightRequest="316">
            <Image
                Source="login_hero.png"
                Aspect="AspectFill"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <VerticalStackLayout
                x:Name="HeroContent"
                Padding="0,26,0,0"
