<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.BookingHistoryPage"
    x:Name="HistoryView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:controls="clr-namespace:UAS_APP_MONICASALON.Controls"
    xmlns:m="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="#FAF7F5"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <RefreshView
            Grid.Row="0"
            IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
            Command="{Binding RefreshCommand}"
            RefreshColor="#D9534F">

            <CollectionView
                ItemsSource="{Binding Bookings}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never"
                ItemSizingStrategy="MeasureAllItems">

                <CollectionView.Header>
                    <VerticalStackLayout Padding="20,16,20,12" Spacing="14">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="RIWAYAT KUNJUNGAN" Style="{StaticResource PageKickerStyle}" />
                                <Label Text="Booking Saya" Style="{StaticResource PageHeadingStyle}" />
                                <Label
                                    Text="Semua slot yang kamu pesan, dalam satu tempat."
                                    FontSize="12"
                                    TextColor="#757575" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="#FDECEC"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24"
                                VerticalOptions="Center">
                                <Image
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="MaterialOutlined"
                                            Glyph="{x:Static m:MaterialRegular.History}"
                                            Color="#D9534F"
                                            Size="24" />
                                    </Image.Source>
                                </Image>
                            </Border>
                        </Grid>

                        <Border
                            BackgroundColor="#8B2626"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="SLOT AKTIF"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#F3C7C4"
                                        CharacterSpacing="1" />
                                    <Label
                                        Text="{Binding SummaryText}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="#FFFFFF"
                                        LineHeight="1.3" />
                                </VerticalStackLayout>

                                <Image
                                    Grid.Column="1"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="MaterialOutlined"
                                            Glyph="{x:Static m:MaterialRegular.Calendar_month}"
                                            Color="#F8DCDC"
                                            Size="38" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </Border>

                        <Border
                            IsVisible="{Binding HasError}"
                            BackgroundColor="#F9DEDC"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,8">
                            <Label
                                Text="{Binding ErrorMessage}"
                                FontSize="11"
                                TextColor="#B3261E"
                                LineBreakMode="WordWrap" />
                        </Border>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Filters}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            HeightRequest="36"
                                            Padding="14,0"
                                            BackgroundColor="{Binding BackgroundColor}"
                                            Stroke="{Binding BorderColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 18">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SelectFilterCommand, Source={x:Reference HistoryView}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label
                                                Text="{Binding LabelText}"
                                                FontSize="12"
                                                FontAttributes="{Binding LabelAttributes}"
                                                TextColor="{Binding TextColor}"
                                                VerticalTextAlignment="Center"
                                                InputTransparent="True" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Booking terbaru"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#8B2626" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding FilterSummaryText}"
                                FontSize="11"
                                TextColor="#A79A96"
                                VerticalTextAlignment="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Style="{StaticResource CardStyle}"
                            Margin="20,0,20,12"
                            Padding="14">
                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Code}"
                                            FontSize="10"
                                            TextColor="#A79A96"
                                            CharacterSpacing="0.5" />
                                        <Label
                                            Text="{Binding DateLongText}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#8B2626"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="{Binding StatusBackgroundColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="9,4"
                                        VerticalOptions="Start">
                                        <Label
                                            Text="{Binding StatusText}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{Binding StatusTextColor}" />
                                    </Border>
                                </Grid>

                                <Label
                                    Text="{Binding ServicesText}"
                                    FontSize="13"
                                    TextColor="#757575"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation" />

                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                    <Image WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="MaterialOutlined"
                                                Glyph="{x:Static m:MaterialRegular.Schedule}"
                                                Color="#A79A96"
                                                Size="14" />
                                        </Image.Source>
                                    </Image>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding TimeText}"
                                        FontSize="12"
                                        TextColor="#757575"
                                        VerticalTextAlignment="Center" />
                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding ItemsSummaryText}"
                                        FontSize="11"
                                        TextColor="#A79A96"
                                        HorizontalTextAlignment="End"
                                        VerticalTextAlignment="Center"
                                        MaxLines="1"
                                        LineBreakMode="TailTruncation" />
                                    <Label
                                        Grid.Column="3"
                                        Text="{Binding TotalText}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#8B2626"
                                        VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#F2E8E5" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <uranium:ButtonView
                                        HeightRequest="38"
                                        BackgroundColor="#D9534F"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="12,0"
                                        TappedCommand="{Binding BindingContext.OpenBookingCommand, Source={x:Reference HistoryView}}"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="Lihat detail booking">
                                        <Label
                                            Text="Lihat Detail"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="#FFFFFF"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            InputTransparent="True" />
                                    </uranium:ButtonView>

                                    <uranium:ButtonView
                                        Grid.Column="1"
                                        HeightRequest="38"
                                        BackgroundColor="#FFFFFF"
                                        Stroke="#E8D7D2"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="12,0"
                                        IsVisible="{Binding CanLeaveFeedback}"
                                        TappedCommand="{Binding BindingContext.WriteFeedbackCommand, Source={x:Reference HistoryView}}"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="Beri ulasan booking">
                                        <Label
                                            Text="Beri Ulasan"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="#8B2626"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            InputTransparent="True" />
                                    </uranium:ButtonView>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="32,26,32,44"
                        Spacing="10"
                        HorizontalOptions="Center">
                        <Border
                            WidthRequest="64"
                            HeightRequest="64"
                            BackgroundColor="#FDECEC"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 32"
                            HorizontalOptions="Center">
                            <Image
                                WidthRequest="30"
                                HeightRequest="30"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static m:MaterialRegular.Event}"
                                        Color="#D9534F"
                                        Size="30" />
                                </Image.Source>
                            </Image>
                        </Border>
                        <Label
                            Text="Belum ada booking di filter ini."
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#8B2626"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Pilih layanan dan slot favoritmu — booking langsung terkonfirmasi."
                            FontSize="12"
                            TextColor="#757575"
                            HorizontalTextAlignment="Center"
                            MaximumWidthRequest="260" />
                        <Button
                            Text="Buat Booking"
                            Command="{Binding BindingContext.BookNowCommand, Source={x:Reference HistoryView}}"
                            Style="{StaticResource PrimaryActionStyle}"
                            WidthRequest="180"
                            Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.Footer>
                    <BoxView HeightRequest="8" Color="Transparent" />
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

        <ActivityIndicator
            Grid.Row="0"
            IsVisible="{Binding IsLoading}"
            IsRunning="{Binding IsLoading}"
            Color="#D9534F"
            WidthRequest="30"
            HeightRequest="30"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <controls:BottomNavBar Grid.Row="1" ActiveTab="Riwayat" />
    </Grid>

</uranium:UraniumContentPage>
