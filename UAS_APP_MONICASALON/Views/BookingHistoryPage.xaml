<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.BookingHistoryPage"
    x:Name="HistoryView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:controls="clr-namespace:UAS_APP_MONICASALON.Controls"
    xmlns:m="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="#FAF7F5"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <RefreshView
            Grid.Row="0"
            IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
            Command="{Binding RefreshCommand}"
            RefreshColor="#D9534F">

            <CollectionView
                ItemsSource="{Binding Bookings}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never"
                ItemSizingStrategy="MeasureAllItems"
                MaximumWidthRequest="720"
                HorizontalOptions="Center">

                <CollectionView.Header>
                    <VerticalStackLayout Padding="20,18,20,12" Spacing="14">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="RIWAYAT KUNJUNGAN" Style="{StaticResource PageKickerStyle}" />
                            <Label Text="Booking Saya" Style="{StaticResource PageHeadingStyle}" />
                            <Label
                                Text="Lihat jadwal dan detail kunjunganmu di Monica Salon."
                                FontSize="12"
                                TextColor="#757575" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="6">
                            <Image
                                WidthRequest="14"
                                HeightRequest="14"
                                VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static m:MaterialRegular.Calendar_month}"
                                        Color="#D9534F"
                                        Size="14" />
                                </Image.Source>
                            </Image>
                            <Label
                                Text="{Binding SummaryText}"
                                FontSize="12"
                                TextColor="#757575"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <Border
                            IsVisible="{Binding HasError}"
                            BackgroundColor="#F9DEDC"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,8">
                            <Label
                                Text="{Binding ErrorMessage}"
                                FontSize="11"
                                TextColor="#B3261E"
                                LineBreakMode="WordWrap" />
                        </Border>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Filters}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            HeightRequest="36"
                                            Padding="14,0"
                                            BackgroundColor="{Binding BackgroundColor}"
                                            Stroke="{Binding BorderColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 18">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SelectFilterCommand, Source={x:Reference HistoryView}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label
                                                Text="{Binding LabelText}"
                                                FontSize="12"
                                                FontAttributes="{Binding LabelAttributes}"
                                                TextColor="{Binding TextColor}"
                                                VerticalTextAlignment="Center"
                                                InputTransparent="True" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label
                                Text="Daftar Booking"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#8B2626" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding FilterSummaryText}"
                                FontSize="11"
                                TextColor="#A79A96"
                                VerticalTextAlignment="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Style="{StaticResource CardStyle}"
                            Margin="20,0,20,12"
                            Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenBookingCommand, Source={x:Reference HistoryView}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                    <!-- Date badge -->
                                    <Border
                                        WidthRequest="52"
                                        HeightRequest="58"
                                        BackgroundColor="#FDECEC"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Start">
                                        <VerticalStackLayout
                                            Spacing="0"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                            <Label
                                                Text="{Binding DateDayText}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                TextColor="#8B2626"
                                                HorizontalTextAlignment="Center" />
                                            <Label
                                                Text="{Binding DateMonthText}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="#D9534F"
                                                CharacterSpacing="0.8"
                                                TextTransform="Uppercase"
                                                HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Booking summary -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding ServicesText}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="#1E1E1E"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />

                                        <HorizontalStackLayout Spacing="4">
                                            <Image
                                                WidthRequest="13"
                                                HeightRequest="13"
                                                VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="MaterialOutlined"
                                                        Glyph="{x:Static m:MaterialRegular.Schedule}"
                                                        Color="#A79A96"
                                                        Size="13" />
                                                </Image.Source>
                                            </Image>
                                            <Label
                                                Text="{Binding ScheduleText}"
                                                FontSize="11"
                                                TextColor="#757575"
                                                VerticalTextAlignment="Center"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>

                                        <Label
                                            Text="{Binding Code}"
                                            FontSize="10"
                                            TextColor="#A79A96"
                                            CharacterSpacing="0.4" />
                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Column="2"
                                        BackgroundColor="{Binding StatusBackgroundColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="8,4"
                                        VerticalOptions="Start">
                                        <Label
                                            Text="{Binding StatusText}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{Binding StatusTextColor}" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#F2E8E5" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label
                                        Text="{Binding ItemsSummaryText}"
                                        FontSize="11"
                                        TextColor="#A79A96"
                                        VerticalTextAlignment="Center"
                                        MaxLines="1"
                                        LineBreakMode="TailTruncation" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding TotalText}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#8B2626"
                                        VerticalTextAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <Label
                                        Text="Lihat detail"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#D9534F"
                                        VerticalTextAlignment="Center" />
                                    <Image
                                        Grid.Column="1"
                                        WidthRequest="15"
                                        HeightRequest="15"
                                        VerticalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="MaterialOutlined"
                                                Glyph="{x:Static m:MaterialRegular.Chevron_right}"
                                                Color="#D9534F"
                                                Size="15" />
                                        </Image.Source>
                                    </Image>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="32,26,32,44"
                        Spacing="10"
                        HorizontalOptions="Center">
                        <Border
                            WidthRequest="64"
                            HeightRequest="64"
                            BackgroundColor="#FDECEC"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 32"
                            HorizontalOptions="Center">
                            <Image
                                WidthRequest="30"
                                HeightRequest="30"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static m:MaterialRegular.Event}"
                                        Color="#D9534F"
                                        Size="30" />
                                </Image.Source>
                            </Image>
                        </Border>
                        <Label
                            Text="Belum ada booking di filter ini."
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#8B2626"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Pilih layanan serta tanggal dan jam favoritmu. Admin akan mengonfirmasi jadwalnya."
                            FontSize="12"
                            TextColor="#757575"
                            HorizontalTextAlignment="Center"
                            MaximumWidthRequest="260" />
                        <Button
                            Text="Buat Booking"
                            Command="{Binding BindingContext.BookNowCommand, Source={x:Reference HistoryView}}"
                            Style="{StaticResource PrimaryActionStyle}"
                            HorizontalOptions="Center"
                            Padding="24,0"
                            Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.Footer>
                    <BoxView HeightRequest="8" Color="Transparent" />
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

        <ActivityIndicator
            Grid.Row="0"
            IsVisible="{Binding IsLoading}"
            IsRunning="{Binding IsLoading}"
            Color="#D9534F"
            WidthRequest="30"
            HeightRequest="30"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <controls:BottomNavBar Grid.Row="1" ActiveTab="Riwayat" />
    </Grid>

</uranium:UraniumContentPage>
