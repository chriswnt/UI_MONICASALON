<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.BookingFeedbackPage"
    x:Name="FeedbackView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:m="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="#FAF7F5"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Padding="20,14,20,8" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <uranium:ButtonView
                WidthRequest="40"
                HeightRequest="40"
                BackgroundColor="#FFFFFF"
                Stroke="#EFE6E4"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="0"
                VerticalOptions="Center"
                TappedCommand="{Binding BackCommand}"
                SemanticProperties.Description="Kembali">
                <Image
                    WidthRequest="21"
                    HeightRequest="21"
                    InputTransparent="True"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource
                            FontFamily="MaterialOutlined"
                            Glyph="{x:Static m:MaterialRegular.Arrow_back}"
                            Color="#1E1E1E"
                            Size="21" />
                    </Image.Source>
                </Image>
            </uranium:ButtonView>

            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="PENGALAMANMU" Style="{StaticResource PageKickerStyle}" />
                <Label Text="{Binding TitleText}" Style="{StaticResource PageHeadingStyle}" FontSize="20" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1">

            <ScrollView IsVisible="{Binding HasBooking}">
                <VerticalStackLayout Padding="20,4,20,24" Spacing="14">

                    <Label
                        Text="Ulasanmu membantu Monica Salon menjaga kualitas layanan dan memberi rekomendasi yang lebih tepat."
                        FontSize="12"
                        TextColor="#757575"
                        LineHeight="1.35" />

                    <!-- Booking summary -->
                    <Border BackgroundColor="#8B2626" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="{Binding Booking.Code}"
                                FontSize="10"
                                TextColor="#F3C7C4" />
                            <Label
                                Text="{Binding Booking.ServicesText}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#FFFFFF"
                                LineBreakMode="WordWrap" />
                            <HorizontalStackLayout Spacing="6">
                                <Label
                                    Text="{Binding Booking.DateCardText}"
                                    FontSize="11"
                                    TextColor="#FBE3E1" />
                                <Label Text="•" FontSize="11" TextColor="#C88C88" />
                                <Label
                                    Text="{Binding Booking.TimeText}"
                                    FontSize="11"
                                    TextColor="#FBE3E1" />
                                <Label Text="•" FontSize="11" TextColor="#C88C88" />
                                <Label
                                    Text="{Binding Booking.HairstyleName}"
                                    FontSize="11"
                                    TextColor="#FBE3E1" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        IsVisible="{Binding HasExistingFeedback}"
                        BackgroundColor="#FEF3C7"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,9">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Start" Margin="0,1,0,0">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static m:MaterialRegular.Info}"
                                        Color="#8A5A00"
                                        Size="16" />
                                </Image.Source>
                            </Image>
                            <Label
                                Grid.Column="1"
                                Text="Kamu sudah pernah mengirim ulasan. Perubahan akan menyimpan ulasan terbaru."
                                FontSize="11"
                                TextColor="#8A5A00"
                                LineHeight="1.35" />
                        </Grid>
                    </Border>

                    <!-- Rating -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Seberapa puas hasilnya?" Style="{StaticResource SectionTitleStyle}" />
                            <Label
                                Text="Ketuk bintang untuk memberi nilai."
                                FontSize="11"
                                TextColor="#A79A96" />

                            <HorizontalStackLayout
                                Spacing="2"
                                HorizontalOptions="Center"
                                Margin="0,4,0,0"
                                BindableLayout.ItemsSource="{Binding Stars}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <uranium:ButtonView
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            BackgroundColor="Transparent"
                                            StrokeThickness="0"
                                            Padding="0"
                                            TappedCommand="{Binding BindingContext.SetRatingCommand, Source={x:Reference FeedbackView}}"
                                            CommandParameter="{Binding Value}"
                                            SemanticProperties.Description="Beri rating bintang">
                                            <Label
                                                Text="{Binding Glyph}"
                                                FontSize="36"
                                                TextColor="{Binding TextColor}"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                InputTransparent="True" />
                                        </uranium:ButtonView>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <Label
                                Text="{Binding RatingText}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#D9534F"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tags -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Apa yang paling berkesan?" Style="{StaticResource SectionTitleStyle}" />
                            <Label
                                Text="Boleh pilih lebih dari satu."
                                FontSize="11"
                                TextColor="#A79A96" />

                            <FlexLayout
                                Wrap="Wrap"
                                JustifyContent="Start"
                                BindableLayout.ItemsSource="{Binding Tags}"
                                Margin="0,2,0,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            HeightRequest="34"
                                            Padding="12,0"
                                            Margin="0,0,8,8"
                                            BackgroundColor="{Binding BackgroundColor}"
                                            Stroke="{Binding BorderColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 17">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.ToggleTagCommand, Source={x:Reference FeedbackView}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label
                                                Text="{Binding LabelText}"
                                                FontSize="11"
                                                FontAttributes="{Binding LabelAttributes}"
                                                TextColor="{Binding TextColor}"
                                                VerticalTextAlignment="Center"
                                                InputTransparent="True" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Comment -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Ceritakan pengalamanmu" Style="{StaticResource SectionTitleStyle}" />
                            <Label
                                Text="Opsional, tapi sangat membantu stylist kami."
                                FontSize="11"
                                TextColor="#A79A96" />

                            <Border
                                BackgroundColor="#FAF7F5"
                                Stroke="#EFE6E4"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,6">
                                <Editor
                                    Text="{Binding Comment, Mode=TwoWay}"
                                    Placeholder="Contoh: hasilnya sesuai referensi, stylist ramah, tempatnya nyaman..."
                                    PlaceholderColor="#B7A8A3"
                                    TextColor="#1E1E1E"
                                    BackgroundColor="Transparent"
                                    FontSize="12"
                                    MaxLength="240"
                                    AutoSize="Disabled"
                                    HeightRequest="100" />
                            </Border>

                            <Label
                                Text="{Binding CommentCountText}"
                                FontSize="10"
                                TextColor="#A79A96"
                                HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <ActivityIndicator
                IsVisible="{Binding IsLoading}"
                IsRunning="{Binding IsLoading}"
                Color="#D9534F"
                WidthRequest="30"
                HeightRequest="30"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <VerticalStackLayout
                IsVisible="{Binding ShowLoadError}"
                Padding="20"
                Spacing="10"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label
                    Text="{Binding ErrorMessage}"
                    FontSize="12"
                    TextColor="#B3261E"
                    HorizontalTextAlignment="Center" />
                <Button
                    Text="Kembali"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource SecondaryActionStyle}"
                    WidthRequest="160" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="2" BackgroundColor="#FFFFFF" RowDefinitions="1,Auto">
            <BoxView HeightRequest="1" BackgroundColor="#EFE6E4" />
            <VerticalStackLayout Grid.Row="1" Padding="20,10,20,16" Spacing="8" IsVisible="{Binding HasBooking}">
                <Label
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    FontSize="11"
                    TextColor="#B3261E"
                    HorizontalTextAlignment="Center" />
                <Button
                    Text="{Binding SubmitButtonText}"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding IsNotSubmitting}"
                    Style="{StaticResource PrimaryActionStyle}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</uranium:UraniumContentPage>
