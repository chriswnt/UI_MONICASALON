<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:controls="clr-namespace:UAS_APP_MONICASALON.Controls">

    <!-- ============================================================
         MONICA SALON — ADMIN SHARED STYLES
         Keyed styles only, so customer screens keep their defaults.
         ============================================================ -->

    <Style x:Key="AdminPageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <!-- Accessibility: expose the page title as the top heading for screen readers. -->
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>

    <Style x:Key="AdminSectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <!-- Accessibility: section titles are level-2 headings. -->
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="AdminSectionSubtitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="AdminCaption" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="AdminFilterLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <Style x:Key="AdminCellTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="AdminCellMeta" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="AdminCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Outline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="AdminSoftCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="AdminPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="40" />
    </Style>

    <Style x:Key="AdminSecondaryButton" TargetType="Button" BasedOn="{StaticResource AdminPrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
    </Style>

    <Style x:Key="AdminDangerButton" TargetType="Button" BasedOn="{StaticResource AdminPrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorContainer}" />
        <Setter Property="TextColor" Value="{StaticResource Error}" />
    </Style>

    <Style x:Key="AdminLinkButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="40" />
    </Style>

    <Style x:Key="AdminSoftButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="64" />
    </Style>

    <Style x:Key="AdminTextField" TargetType="material:TextField">
        <Setter Property="AccentColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TitleFontSize" Value="11" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>

    <Style x:Key="AdminDropdown" TargetType="uranium:Dropdown">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="AdminFieldButton" TargetType="controls:ButtonView">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Outline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>

    <Style TargetType="Button" Class="CalendarView.DayButton">
        <Setter Property="MinimumHeightRequest" Value="30" />
        <Setter Property="MinimumWidthRequest" Value="30" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style TargetType="Label" Class="CalendarView.MonthLabel">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style TargetType="Label" Class="CalendarView.WeekdayLabel">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="AdminInputShell" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Outline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AdminIconButton" TargetType="controls:ButtonView">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Outline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 19" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="38" />
        <Setter Property="HeightRequest" Value="38" />
    </Style>

    <!-- ============================================================
         CASHIER & BOOKING MODULES (Phase 3)
         Additive keyed styles only — every key above is untouched.
         ============================================================ -->

    <Style x:Key="AdminCardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="AdminAmountLarge" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="AdminAmountMedium" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="AdminAmountPrimary" TargetType="Label" BasedOn="{StaticResource AdminAmountMedium}">
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
    </Style>

    <Style x:Key="AdminSummaryLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="AdminSummaryValue" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="AdminListRow" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="AdminBannerBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource InfoContainer}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="AdminErrorBanner" TargetType="Border" BasedOn="{StaticResource AdminBannerBorder}">
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorContainer}" />
    </Style>

    <Style x:Key="AdminSuccessBanner" TargetType="Border" BasedOn="{StaticResource AdminBannerBorder}">
        <Setter Property="BackgroundColor" Value="{StaticResource SuccessContainer}" />
    </Style>

    <Style x:Key="AdminWarningBanner" TargetType="Border" BasedOn="{StaticResource AdminBannerBorder}">
        <Setter Property="BackgroundColor" Value="{StaticResource TertiaryContainer}" />
    </Style>

    <Style x:Key="AdminBannerTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="AdminBannerText" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="AdminCompactButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style x:Key="AdminQtyButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="32" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="AdminDangerLinkButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Error}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style x:Key="AdminChipButton" TargetType="controls:ButtonView">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Outline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="MinimumHeightRequest" Value="32" />
    </Style>

    <Style x:Key="AdminChipLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="AdminStepTrack" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Color" Value="{StaticResource Outline}" />
    </Style>

    <Style x:Key="AdminStepTrackActive" TargetType="BoxView" BasedOn="{StaticResource AdminStepTrack}">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>

    <Style x:Key="AdminStepLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="AdminStepLabelActive" TargetType="Label" BasedOn="{StaticResource AdminStepLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
    </Style>

    <Style x:Key="AdminCounterBadge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 9" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="MinimumWidthRequest" Value="18" />
        <Setter Property="MinimumHeightRequest" Value="18" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <Style x:Key="AdminCounterBadgeText" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="AdminStateCircle" TargetType="Border">
        <Setter Property="WidthRequest" Value="84" />
        <Setter Property="HeightRequest" Value="84" />
        <Setter Property="BackgroundColor" Value="{StaticResource SuccessContainer}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 42" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="AdminEmptyStateIcon" TargetType="Image">
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <!-- Accessibility: decorative glyph, the text below carries the meaning. -->
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
    </Style>

    <Style x:Key="AdminDecorativeIcon" TargetType="Image">
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
    </Style>

    <Style x:Key="AdminReceiptRule" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource Outline}" />
    </Style>

    <!-- Icon button built from a real Button (not ButtonView) so screen readers can
         invoke it and it stays safe on pages that get popped. -->
    <Style x:Key="AdminIconGlyphButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="BorderColor" Value="{StaticResource Outline}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumWidthRequest" Value="42" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="ContentLayout" Value="Left,0" />
    </Style>

    <Style x:Key="AdminDatePicker" TargetType="DatePicker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Format" Value="dd/MM/yyyy" />
    </Style>

    <Style x:Key="AdminIconGlyphPrimaryButton" TargetType="Button" BasedOn="{StaticResource AdminIconGlyphButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

</ResourceDictionary>
