<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================
         MONICA SALON — CORAL / TERRACOTTA DESIGN TOKENS
         PRD Phase 1, section 3.1
         ============================================================ -->

    <!-- Brand core -->
    <Color x:Key="Primary">#D9534F</Color>
    <Color x:Key="PrimaryDark">#8B2626</Color>
    <Color x:Key="PrimaryDarkText">#1E1E1E</Color>
    <Color x:Key="Secondary">#FDECEC</Color>
    <Color x:Key="SecondaryDarkText">#8B2626</Color>
    <Color x:Key="Tertiary">#F59E0B</Color>

    <!-- PRD named tokens -->
    <Color x:Key="TextPrimary">#1E1E1E</Color>
    <Color x:Key="TextSecondary">#757575</Color>
    <Color x:Key="Accent">#F59E0B</Color>
    <Color x:Key="SurfaceTint">#FDECEC</Color>
    <Color x:Key="Coral">#D9534F</Color>
    <Color x:Key="CoralDark">#8B2626</Color>
    <Color x:Key="Blush">#FDECEC</Color>
    <Color x:Key="Alabaster">#FAF7F5</Color>
    <Color x:Key="BorderWarm">#EFE6E4</Color>

    <!-- Material light scheme -->
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryContainer">#FDECEC</Color>
    <Color x:Key="OnPrimaryContainer">#8B2626</Color>

    <Color x:Key="OnSecondary">#8B2626</Color>
    <Color x:Key="SecondaryContainer">#FDECEC</Color>
    <Color x:Key="OnSecondaryContainer">#8B2626</Color>

    <Color x:Key="OnTertiary">#1E1E1E</Color>
    <Color x:Key="TertiaryContainer">#FEF3C7</Color>
    <Color x:Key="OnTertiaryContainer">#8B2626</Color>

    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="OnSurface">#1E1E1E</Color>
    <Color x:Key="SurfaceVariant">#FDECEC</Color>
    <Color x:Key="OnSurfaceVariant">#757575</Color>

    <Color x:Key="Background">#FAF7F5</Color>
    <Color x:Key="OnBackground">#1E1E1E</Color>

    <Color x:Key="Error">#B3261E</Color>
    <Color x:Key="ErrorContainer">#F9DEDC</Color>
    <Color x:Key="OnError">#FFFFFF</Color>
    <Color x:Key="OnErrorContainer">#370B1E</Color>

    <Color x:Key="Outline">#EFE6E4</Color>
    <Color x:Key="OutlineVariant">#EFE6E4</Color>
    <Color x:Key="Shadow">#000000</Color>

    <Color x:Key="InverseSurface">#313033</Color>
    <Color x:Key="InverseOnSurface">#F4EFF4</Color>
    <Color x:Key="InversePrimary">#D9534F</Color>
    <Color x:Key="Scrim">#000000</Color>

    <!-- Material dark scheme -->
    <Color x:Key="OnPrimaryDark">#FFFFFF</Color>
    <Color x:Key="PrimaryContainerDark">#4A1A1A</Color>
    <Color x:Key="OnPrimaryContainerDark">#FDECEC</Color>

    <Color x:Key="SecondaryDark">#8B2626</Color>
    <Color x:Key="OnSecondaryDark">#FDECEC</Color>
    <Color x:Key="SecondaryContainerDark">#4A1A1A</Color>
    <Color x:Key="OnSecondaryContainerDark">#FDECEC</Color>

    <Color x:Key="TertiaryDark">#F59E0B</Color>
    <Color x:Key="OnTertiaryDark">#1E1E1E</Color>
    <Color x:Key="TertiaryContainerDark">#5C3A00</Color>
    <Color x:Key="OnTertiaryContainerDark">#FEF3C7</Color>

    <Color x:Key="SurfaceDark">#241C1B</Color>
    <Color x:Key="OnSurfaceDark">#FAF7F5</Color>
    <Color x:Key="SurfaceVariantDark">#3A2E2C</Color>
    <Color x:Key="OnSurfaceVariantDark">#D8C8C4</Color>

    <Color x:Key="BackgroundDark">#1A1413</Color>
    <Color x:Key="OnBackgroundDark">#FAF7F5</Color>

    <Color x:Key="ErrorDark">#F2B8B5</Color>
    <Color x:Key="ErrorContainerDark">#8C1D18</Color>
    <Color x:Key="OnErrorDark">#601410</Color>
    <Color x:Key="OnErrorContainerDark">#F9DEDC</Color>

    <Color x:Key="OutlineDark">#4A3A38</Color>
    <Color x:Key="OutlineVariantDark">#3A2E2C</Color>
    <Color x:Key="ShadowDark">#000000</Color>

    <Color x:Key="InverseSurfaceDark">#E6E1E5</Color>
    <Color x:Key="InverseOnSurfaceDark">#313033</Color>
    <Color x:Key="InversePrimaryDark">#D9534F</Color>
    <Color x:Key="ScrimDark">#000000</Color>

    <Color x:Key="DisabledText">#B0757575</Color>
    <Color x:Key="DisabledBackground">#80EFE6E4</Color>

    <!-- Status feedback tokens (Admin) -->
    <Color x:Key="Success">#2E7D5B</Color>
    <Color x:Key="SuccessContainer">#E6F4EC</Color>
    <Color x:Key="Warning">#9A6400</Color>
    <Color x:Key="Info">#2F6F9F</Color>
    <Color x:Key="InfoContainer">#E7F1F8</Color>

    <!-- MAUI template compatibility -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D9534F</Color>
    <Color x:Key="MidnightBlue">#8B2626</Color>
    <Color x:Key="OffBlack">#1E1E1E</Color>

    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#E5E5E5</Color>
    <Color x:Key="Gray300">#D4D4D4</Color>
    <Color x:Key="Gray400">#A3A3A3</Color>
    <Color x:Key="Gray500">#757575</Color>
    <Color x:Key="Gray600">#525252</Color>
    <Color x:Key="Gray900">#1E1E1E</Color>
    <Color x:Key="Gray950">#121212</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainer}" />
    <SolidColorBrush x:Key="PrimaryContainerDarkBrush" Color="{StaticResource PrimaryContainerDark}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{StaticResource OnSecondaryContainer}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainer}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariant}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainer}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimary}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainer}" />
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="{StaticResource OnTertiary}" />
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="{StaticResource OnTertiaryContainer}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurface}" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariant}" />
    <SolidColorBrush x:Key="OnErrorBrush" Color="{StaticResource OnError}" />
    <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{StaticResource OnErrorContainer}" />
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="{StaticResource OnBackground}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource Outline}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariant}" />
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource Shadow}" />
    <SolidColorBrush x:Key="InversePrimaryBrush" Color="{StaticResource InversePrimary}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource Scrim}" />

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

</ResourceDictionary>
