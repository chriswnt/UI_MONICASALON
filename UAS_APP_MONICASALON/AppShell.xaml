<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UAS_APP_MONICASALON.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:UAS_APP_MONICASALON.Views"
    Title="Monica Salon"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#FAF7F5">

    <!-- Login and Home are separate shell roots so returning home from a
         finished booking can reset the navigation stack with a single
         absolute route. The flyout stays disabled. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <FlyoutItem
        Title="Login"
        Route="LoginRoot"
        FlyoutItemIsVisible="False">
        <ShellContent
            Title="Login"
            Route="LoginPage"
            ContentTemplate="{DataTemplate views:LoginPage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="Home"
        Route="HomeRoot"
        FlyoutItemIsVisible="False">
        <ShellContent
            Title="Home"
            Route="HomeCustomerPage"
            ContentTemplate="{DataTemplate views:HomeCustomerPage}" />
    </FlyoutItem>

</Shell>
